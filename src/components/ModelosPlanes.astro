---
import Icon from '@/components/Icon.astro';
import { listPlans } from '@/data/plans';
import { planesVisibles } from '@/utils/site';

// Vidriera de planes: un modelo de muestra por tier, con las features REALES
// de cada plan (misma fuente que /planes). No finge negocios: todo rotulado MUESTRA.
const planes = planesVisibles(await listPlans());

const ESTILO: Record<string, { header: string; pill: string; inicial: string }> = {
  gratis: { header: 'from-brand-600 to-indigo-600', pill: 'bg-white/20 text-white', inicial: 'G' },
  bronce: { header: 'from-amber-600 to-orange-700', pill: 'bg-white/20 text-white', inicial: 'B' },
  plata: { header: 'from-slate-600 to-slate-900', pill: 'bg-white/20 text-white', inicial: 'P' },
  oro: { header: 'from-amber-400 to-yellow-500', pill: 'bg-ink-950/80 text-amber-300', inicial: 'O' },
};
---

<section aria-label="Modelos de muestra por plan" class="mt-12">
  <div class="max-w-2xl">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600 mb-2">Modelos de muestra</p>
    <h2 class="font-display font-bold text-2xl sm:text-3xl tracking-tight text-balance">Así se ve cada plan</h2>
    <p class="mt-2 text-slate-600">Un ejemplo tal cual es cada plan, sin letra chica.</p>
  </div>

  {/* 4 columnas solo en xl: entre lg y xl (1024-1280) las pills del header
      (COMERCIO VERIFICADO + MUESTRA) colisionaban. En 2 columnas hay aire de sobra. */}
  <div class:list={['mt-6 grid gap-5 sm:grid-cols-2', planes.length > 2 ? 'xl:grid-cols-4' : 'max-w-3xl mx-auto']} data-reveal-group>
    {
      planes.map((p) => {
        const e = ESTILO[p.tier] ?? ESTILO.gratis;
        const href = p.tier === 'gratis' ? '/publicar' : `/publicar?plan=${p.tier}`;
        return (
          <article data-modelo-plan={p.tier} class="card-hover bg-white rounded-2xl border border-ink-100 shadow-sm hover:shadow-lg overflow-hidden flex flex-col">
            <div class={`bg-gradient-to-br ${e.header} p-5 text-white`}>
              <div class="flex items-center justify-between gap-2">
                <span class={`px-2 py-1 rounded-full text-[10px] font-bold whitespace-nowrap ${e.pill}`}>{p.name.toUpperCase()}</span>
                <span class="px-2 py-1 rounded-full text-[10px] font-bold whitespace-nowrap bg-white text-ink-950">MUESTRA</span>
              </div>
              <div class="mt-4 flex items-center gap-3">
                <span class="w-11 h-11 shrink-0 rounded-xl bg-white/20 grid place-items-center font-display font-extrabold text-xl" aria-hidden="true">
                  {e.inicial}
                </span>
                <div class="min-w-0">
                  {/* min-h de 2 líneas: "Comercio Verificado" ocupa 2 y el resto 1;
                      sin esto los precios no quedan alineados entre cards. */}
                  <p class="font-display font-bold leading-snug min-h-[2.6em] flex items-center">Modelo {p.name}</p>
                  <p class="text-xs opacity-80">{p.priceLabel}</p>
                </div>
              </div>
            </div>
            <div class="p-5 flex flex-col flex-1">
              <ul class="space-y-2 text-[13px] flex-1">
                {p.features.map((f) => (
                  <li class="flex gap-2">
                    <span class="text-emerald-500 font-bold" aria-hidden="true">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
                {(p.limitations ?? []).map((l) => (
                  <li class="flex gap-2 text-slate-400">
                    <span aria-hidden="true">–</span>
                    <span>{l}</span>
                  </li>
                ))}
              </ul>
              <a
                href={href}
                data-event="slot_publicar"
                data-props={JSON.stringify({ origen: 'modelo-plan', plan: p.tier })}
                class="mt-4 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-ink-950 text-white text-sm font-bold hover:bg-ink-800 active:scale-[0.98] transition">
                {p.cta} <Icon name="arrow-right" size={15} />
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
