---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Foto del design system: acepta metadata local (optimiza responsive) o
// ruta pública (SVG/públicos van directo). Una sola API para cards y fichas.
interface Props {
  src: ImageMetadata | string;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  src,
  alt,
  widths = [800],
  sizes = '100vw',
  class: cls = '',
  loading = 'lazy',
  decoding = 'async',
  fetchpriority = 'auto',
} = Astro.props;
---

{
  typeof src === 'string' ? (
    <img
      src={src}
      alt={alt}
      sizes={sizes}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
      class={cls}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      format="webp"
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
      class={cls}
    />
  )
}
