---
import Icon from '@/components/Icon.astro';
import type { Business } from '@/types';

interface Props {
  businesses: Business[];
}

const { businesses } = Astro.props;
const farmacias = businesses.filter((business) => business.category === 'salud');
const emergencias = [
  { nombre: 'Policía', numero: '911', tono: 'bg-red-50 text-red-700 border-red-100' },
  { nombre: 'Bomberos', numero: '100', tono: 'bg-orange-50 text-orange-700 border-orange-100' },
  { nombre: 'Emergencias médicas', numero: '107', tono: 'bg-rose-50 text-rose-700 border-rose-100' },
];
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 pt-16" aria-labelledby="informacion-util">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600 mb-2">Para todos los días</p>
      <h2 id="informacion-util" class="font-display font-bold text-3xl tracking-tight text-ink-900">Información útil de Las Flores</h2>
    </div>
    <p class="max-w-sm text-sm leading-relaxed text-slate-500 sm:text-right">Lo que necesitás resolver rápido, en un solo lugar.</p>
  </div>

  <div class="mt-7 grid gap-5 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="grid gap-5 md:grid-cols-2">
      <article class="rounded-2xl border border-ink-100 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-emerald-100 text-xl text-emerald-700" aria-hidden="true">✚</span>
            <div>
              <h3 class="font-display font-bold text-lg">Farmacias de turno</h3>
              <p class="text-xs text-slate-500">Turno de hoy · Las Flores</p>
            </div>
          </div>
          <span class="rounded-full bg-amber-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-amber-700">Se actualiza a diario</span>
        </div>

        {farmacias.length > 0 ? (
          <div class="mt-5 space-y-3">
            {farmacias.slice(0, 2).map((farmacia) => (
              <div class="rounded-xl border border-ink-100 bg-ink-50 p-3">
                <h4 class="font-semibold text-sm">{farmacia.name}</h4>
                <p class="mt-1 flex items-center gap-1.5 text-xs text-slate-500"><Icon name="pin" size={13} /> {farmacia.address}</p>
                <a href={`tel:+${farmacia.phone}`} class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 px-3 py-2 text-xs font-bold text-white transition hover:bg-emerald-700"><Icon name="phone" size={14} /> Llamar</a>
              </div>
            ))}
          </div>
        ) : (
          <div class="mt-5 rounded-xl border border-dashed border-ink-200 bg-ink-50 p-4">
            <p class="text-sm font-semibold text-ink-900">Todavía no cargamos el turno de hoy.</p>
            <p class="mt-1 text-xs leading-relaxed text-slate-500">Estamos preparando este espacio con información confirmada, no estimada.</p>
            <a href="/contacto?asunto=farmacia-de-turno" class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-brand-700 hover:underline">Avisanos cuál está de turno <Icon name="arrow-right" size={14} /></a>
          </div>
        )}
      </article>

      <article class="rounded-2xl border border-ink-100 bg-white p-5 shadow-sm">
        <div class="flex items-center gap-3">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-red-100 text-lg font-black text-red-700" aria-hidden="true">!</span>
          <div>
            <h3 class="font-display font-bold text-lg">Emergencias</h3>
            <p class="text-xs text-slate-500">Gratuitos · Las 24 h</p>
          </div>
        </div>
        <div class="mt-5 space-y-2">
          {emergencias.map((item) => (
            <a href={`tel:${item.numero}`} class={`flex items-center justify-between rounded-xl border px-3 py-2.5 transition hover:brightness-95 ${item.tono}`}>
              <span class="flex items-center gap-2 text-sm font-semibold"><Icon name="phone" size={14} /> {item.nombre}</span>
              <span class="font-display text-lg font-extrabold">{item.numero}</span>
            </a>
          ))}
        </div>
        <p class="mt-4 flex items-center gap-1.5 text-[11px] leading-relaxed text-slate-400"><Icon name="clock" size={13} /> Ante una urgencia, llamá sin dudar.</p>
      </article>
    </div>

    <aside class="space-y-5">
      <article class="rounded-2xl bg-ink-950 p-5 text-white">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-emerald-400/15 text-xl font-bold text-emerald-300" aria-hidden="true">$</span>
            <h3 class="font-display font-bold text-lg">Dólar hoy</h3>
          </div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-2.5 py-1 text-[11px] font-bold text-emerald-300">
            <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-300 opacity-75"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-300"></span>
            </span>
            <span data-dolar-origen>Al cargar</span>
          </span>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <div class="rounded-xl border border-white/10 bg-white/5 p-3">
            <p class="text-[11px] font-bold uppercase text-slate-400">Oficial</p>
            <p class="mt-1 text-[10px] uppercase text-slate-500">Venta</p>
            <p class="font-display text-2xl font-extrabold tabular-nums text-white" aria-live="polite"><span data-dolar-v="oficial">…</span></p>
            <p class="mt-1 text-xs text-slate-400">Compra <span class="font-semibold text-slate-200" data-dolar-c="oficial">…</span></p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-3">
            <p class="text-[11px] font-bold uppercase text-slate-400">Blue</p>
            <p class="mt-1 text-[10px] uppercase text-slate-500">Venta</p>
            <p class="font-display text-2xl font-extrabold tabular-nums text-emerald-300" aria-live="polite"><span data-dolar-v="blue">…</span></p>
            <p class="mt-1 text-xs text-slate-400">Compra <span class="font-semibold text-slate-200" data-dolar-c="blue">…</span></p>
          </div>
        </div>
        <p class="mt-3 text-[11px] text-slate-400" data-dolar-meta hidden></p>
        <a href="https://www.bna.com.ar/Personas" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-emerald-300 hover:underline">Consultar en Banco Nación <Icon name="arrow-right" size={14} /></a>
        <script>
          // Dólar en vivo (DolarApi, sin clave): una sola request trae todas las
          // cotizaciones. Solo textContent, con fallback a "Consultar".
          const fmtDolar = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 });
          const numDolar = (v: unknown): number | null => (typeof v === 'number' && Number.isFinite(v) ? v : null);
          fetch('https://dolarapi.com/v1/dolares', { signal: AbortSignal.timeout(8000) })
            .then((r) => (r.ok ? r.json() : []))
            .then((lista) => {
              const casas = new Map(Array.isArray(lista) ? lista.map((d) => [d?.casa, d]) : []);
              let ok = 0;
              (['oficial', 'blue'] as const).forEach((casa) => {
                const d = casas.get(casa) as { compra?: unknown; venta?: unknown; fechaActualizacion?: unknown } | undefined;
                const c = numDolar(d?.compra);
                const v = numDolar(d?.venta);
                document.querySelectorAll(`[data-dolar-c="${casa}"]`).forEach((el) => { el.textContent = c === null ? 'Consultar' : fmtDolar.format(c); });
                document.querySelectorAll(`[data-dolar-v="${casa}"]`).forEach((el) => { el.textContent = v === null ? 'Consultar' : fmtDolar.format(v); });
                if (c !== null && v !== null) {
                  ok++;
                  if (casa === 'blue' && typeof d?.fechaActualizacion === 'string') {
                    const f = new Date(d.fechaActualizacion);
                    const hora = Number.isNaN(f.getTime()) ? null : f.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' }).replace(/\s?[ap]\.?\s?m\.?/i, '');
                    const of = casas.get('oficial') as { venta?: unknown } | undefined;
                    const ov = numDolar(of?.venta);
                    const meta = document.querySelector('[data-dolar-meta]');
                    if (meta) {
                      const brecha = ov && ov > 0 ? ` · Brecha ${(((v - ov) / ov) * 100).toFixed(1).replace('.', ',')}%` : '';
                      meta.textContent = `Actualizado ${hora ?? 'hoy'}${brecha}`;
                      (meta as HTMLElement).hidden = false;
                    }
                  }
                }
              });
              if (ok > 0) document.querySelectorAll('[data-dolar-origen]').forEach((el) => { el.textContent = 'En vivo · DolarApi'; });
            })
            .catch(() => {
              document.querySelectorAll('[data-dolar-c],[data-dolar-v]').forEach((el) => { el.textContent = 'Consultar'; });
            });
        </script>
      </article>

      <article class="rounded-2xl bg-ink-950 p-5 text-white shadow-sm">
        <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-amber-300">¿Tenés un negocio?</p>
        <h3 class="mt-2 font-display text-lg font-bold">Aparecé cuando te buscan</h3>
        <p class="mt-1.5 text-xs leading-relaxed text-slate-300">Publicá gratis tu ficha y empezá a recibir consultas directas.</p>
        <a href="/publicar" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-bold text-ink-900 transition hover:bg-brand-50">Publicar gratis <Icon name="arrow-right" size={15} /></a>
      </article>
    </aside>
  </div>
</section>
