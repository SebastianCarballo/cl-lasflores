---
import type { Plan } from '@/types';
import Icon from '@/components/Icon.astro';

// Vidriera Digital a todo el ancho: es el plan insignia y se muestra después
// de la grilla de 3, no mezclado con ellos. Misma fuente (el JSON del plan)
// que la card vertical, así precio y beneficios nunca divergen.
interface Props {
  plan: Plan;
}
const { plan } = Astro.props;
const [herencia, ...beneficios] = plan.features[0]?.startsWith('Todo lo')
  ? plan.features
  : [null, ...plan.features];
---

<section
  aria-label={`Plan destacado: ${plan.name}`}
  class="mt-6 relative overflow-hidden rounded-[2rem] bg-ink-950 text-white p-8 sm:p-10"
  data-reveal>
  <div class="absolute inset-0 dot-grid" aria-hidden="true" />
  <div class="absolute -top-28 -right-28 w-96 h-96 rounded-full bg-amber-500/20 blur-3xl" aria-hidden="true" />
  <div class="absolute -bottom-32 -left-24 w-80 h-80 rounded-full bg-brand-600/25 blur-3xl" aria-hidden="true" />

  <div class="relative grid gap-8 lg:grid-cols-2 lg:gap-12 items-center">
    <div>
      {plan.badge && (
        <p class="inline-flex px-4 py-1.5 rounded-full text-[11px] font-extrabold uppercase tracking-wide bg-gradient-to-r from-amber-400 to-yellow-500 text-ink-950 shadow-lg">
          ★ {plan.badge}
        </p>
      )}
      <p class="mt-4 text-xs font-bold uppercase tracking-[0.18em] text-amber-300">{plan.kicker}</p>
      <h3 class="mt-1 font-display font-extrabold text-3xl sm:text-4xl tracking-tight text-balance">{plan.name}</h3>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-amber-400/20 text-amber-300" aria-hidden="true">
          <Icon name="megafono" size={22} />
        </span>
        <div>
          <p class="font-display font-extrabold text-3xl leading-none">{plan.priceLabel}</p>
          {plan.annualLabel && (
            <p class="mt-1 text-sm font-semibold text-emerald-300">{plan.annualLabel}</p>
          )}
        </div>
      </div>
      <p class="mt-4 text-slate-300 leading-relaxed">{plan.description}</p>
      <a
        href={`/publicar?plan=${plan.tier}`}
        data-event="elegir_plan"
        data-props={JSON.stringify({ plan: plan.tier })}
        class="mt-6 inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-gradient-to-r from-amber-400 to-yellow-500 text-ink-950 font-bold hover:brightness-105 active:scale-[0.98] transition btn-sheen">
        {plan.cta} <Icon name="arrow-right" size={16} />
      </a>
      <p class="mt-3 text-xs text-slate-400">Sin tarjeta · Sin permanencia</p>
    </div>

    <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
      {herencia && (
        <p class="rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold text-slate-300">
          ＋ {herencia}
        </p>
      )}
      <ul class="mt-4 space-y-3 text-sm">
        {beneficios.map((f) => (
          <li class="flex gap-2.5">
            <span class="text-emerald-400 font-bold" aria-hidden="true">✓</span>
            <span class="text-slate-200">{f}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
