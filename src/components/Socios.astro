---
import Icon from '@/components/Icon.astro';
import { STUDIO } from '@/utils/site';

// Socios estratégicos: MembyStudio (fundador) + espacios abiertos.
// El carrusel es CSS puro: loop infinito, pausa en hover/foco,
// quieto con prefers-reduced-motion. Sin JS, muestra todo estático.
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 pt-16" aria-labelledby="socios-titulo" id="socios">
  <div class="text-center max-w-2xl mx-auto" data-reveal>
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600 mb-3">Socios estratégicos</p>
    <h2 id="socios-titulo" class="font-display font-bold text-3xl sm:text-4xl tracking-tight text-ink-900 text-balance">
      Crecemos con quienes apuestan a Las Flores
    </h2>
    <p class="mt-3 text-slate-600 leading-relaxed text-pretty">
      Clasificados Las Flores nace y crece junto a {STUDIO.name}, la agencia que diseña,
      posiciona y difunde el portal. Quedan lugares para más marcas locales que quieran sumarse.
    </p>
  </div>

  <div class="mt-8 grid md:grid-cols-2 gap-5" data-reveal-group>
    {/* Socio fundador */}
    <article class="relative overflow-hidden rounded-3xl bg-ink-950 text-white p-7 sm:p-8">
      <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-amber-500/15 blur-3xl" aria-hidden="true" />
      <div class="relative">
        <p class="inline-flex px-3 py-1 rounded-full text-[11px] font-bold bg-gradient-to-r from-amber-400 to-yellow-500 text-ink-950 mb-4">
          SOCIO FUNDADOR
        </p>
        <img src="/memby-studio.webp" alt="MembyStudio" width="482" height="112" loading="lazy" decoding="async" class="h-12 max-w-full w-auto" />
        <p class="mt-2 text-xs text-slate-400">{STUDIO.tagline}</p>
        <p class="mt-4 text-sm text-slate-300 leading-relaxed">{STUDIO.rol}</p>
        <ul class="mt-4 space-y-2 text-sm text-slate-300">
          <li class="flex gap-2"><span class="text-emerald-400 font-bold" aria-hidden="true">✓</span> Diseño y desarrollo del portal</li>
          <li class="flex gap-2"><span class="text-emerald-400 font-bold" aria-hidden="true">✓</span> SEO local y contenidos</li>
          <li class="flex gap-2"><span class="text-emerald-400 font-bold" aria-hidden="true">✓</span> Difusión en redes de los comercios con Vidriera Digital</li>
        </ul>
        <a
          href={STUDIO.facebook}
          target="_blank"
          rel="noopener noreferrer"
          data-event="cta_socio"
          class="mt-5 inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white text-ink-900 font-bold text-sm hover:bg-brand-50 active:scale-[0.98] transition slide-arrow">
          Conocé a {STUDIO.name} <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </article>

    {/* Sumarse como socio */}
    <article class="rounded-3xl border-2 border-dashed border-ink-200 bg-white p-7 sm:p-8 flex flex-col">
      <p class="inline-flex w-fit px-3 py-1 rounded-full text-[11px] font-bold bg-brand-600/10 text-brand-700 mb-4">
        CUPOS ABIERTOS
      </p>
      <h3 class="font-display font-bold text-xl">Sumá tu marca como socio</h3>
      <p class="mt-2 text-sm text-slate-600 leading-relaxed">
        Logo en carrusel, menciones en redes, banner permanente y difusión junto
        a los comercios destacados. Para marcas que apuestan a Las Flores.
      </p>
      <ul class="mt-4 space-y-2 text-sm text-slate-600">
        <li class="flex gap-2"><span class="text-brand-600 font-bold" aria-hidden="true">✓</span> Logo en este carrusel, en el inicio</li>
        <li class="flex gap-2"><span class="text-brand-600 font-bold" aria-hidden="true">✓</span> Menciones y contenido conjunto</li>
        <li class="flex gap-2"><span class="text-brand-600 font-bold" aria-hidden="true">✓</span> Acceso anticipado a nuevos formatos</li>
      </ul>
      <a
        href="/contacto"
        data-event="cta_socio_sumarse"
        class="mt-auto pt-5 inline-flex items-center gap-2 w-fit px-5 py-3 rounded-xl bg-brand-600 text-white font-bold text-sm hover:bg-brand-700 active:scale-[0.98] transition slide-arrow">
        Quiero sumar mi marca <Icon name="arrow-right" size={15} />
      </a>
    </article>
  </div>

  {/* Carrusel automático de logos */}
  <div
    class="marquee mt-8 overflow-hidden rounded-3xl border border-ink-100 bg-white py-5 [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]"
    aria-label="Carrusel de socios">
    <div class="marquee-track flex w-max items-center">
      {
        [false, true].map((oculto) => (
          <div class="flex items-center gap-4 pr-4" aria-hidden={oculto || undefined} inert={oculto || undefined}>
            <a
              href={STUDIO.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${STUDIO.name}, socio fundador — ${STUDIO.tagline}`}
              class="flex items-center gap-3 px-5 py-3 rounded-2xl bg-ink-950 text-white shrink-0 hover:scale-[1.03] transition-transform">
              <img src="/memby-studio.webp" alt="" width="482" height="112" loading="lazy" decoding="async" class="h-8 w-auto" />
            </a>
            <a
              href="/"
              aria-label="Clasificados Las Flores"
              class="flex items-center px-5 py-3 rounded-2xl border border-ink-100 bg-white shrink-0 hover:scale-[1.03] transition-transform">
              <img src="/clasificados-las-flores.webp" alt="" width="360" height="97" loading="lazy" decoding="async" class="h-8 w-auto" />
            </a>
            {
              [1, 2, 3].map(() => (
                <a
                  href="/contacto"
                  aria-label="Tu logo acá — Sumate como socio"
                  class="flex items-center gap-3 px-7 py-3 rounded-2xl border-2 border-dashed border-ink-200 text-slate-500 shrink-0 hover:border-brand-400 hover:text-brand-700 transition-colors">
                  <span class="w-9 h-9 rounded-xl bg-ink-100 grid place-items-center font-display font-bold" aria-hidden="true">+</span>
                  <span class="leading-tight text-left">
                    <span class="block font-display font-bold text-sm">Tu logo acá</span>
                    <span class="block text-[11px]">Sumate como socio</span>
                  </span>
                </a>
              ))
            }
          </div>
        ))
      }
    </div>
  </div>
</section>
