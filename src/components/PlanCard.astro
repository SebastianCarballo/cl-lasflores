---
import type { Plan } from '@/types';
import Icon from '@/components/Icon.astro';

interface Props {
  plan: Plan;
}
const { plan } = Astro.props;
const destacado = plan.highlighted;
const esGratis = plan.tier === 'gratis';

// Identidad por tier: cada plan se reconoce de un vistazo (icono + color),
// no solo por el precio. El dorado queda reservado a la Vidriera.
type IconoPlan = 'pin' | 'whatsapp' | 'check' | 'megafono';
const IDENTIDAD: Record<string, { icono: IconoPlan; chip: string }> = {
  gratis: { icono: 'pin', chip: 'bg-ink-100 text-ink-500' },
  bronce: { icono: 'whatsapp', chip: 'bg-orange-100 text-orange-700' },
  plata: { icono: 'check', chip: 'bg-brand-100 text-brand-700' },
  oro: { icono: 'megafono', chip: 'bg-amber-400/25 text-amber-700' },
};
const identidad = IDENTIDAD[plan.tier] ?? IDENTIDAD.gratis;

// Precios largos en cuerpo menor para no romper la card.
const precioLargo = plan.priceLabel.length > 16;

// La herencia ("Todo lo de X") no es un beneficio más: se muestra como línea
// de continuidad arriba de la lista, para que la escalera de planes se lea.
const [herencia, ...beneficios] = plan.features[0]?.startsWith('Todo lo')
  ? plan.features
  : [null, ...plan.features];
---

<article
  class:list={[
    'relative rounded-3xl border p-7 pt-8 flex flex-col bg-white transition hover:-translate-y-1 hover:shadow-xl',
    destacado
      ? 'border-2 border-amber-400 ring-4 ring-amber-400/20 shadow-2xl lg:scale-[1.03]'
      : plan.tier === 'plata'
        ? 'border-2 border-brand-200 shadow-md'
        : 'border-ink-200 shadow-sm',
  ]}>
  {plan.badge && (
    <span
      class:list={[
        'absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full text-[11px] font-extrabold uppercase tracking-wide whitespace-nowrap shadow-lg',
        destacado
          ? 'bg-gradient-to-r from-amber-400 to-yellow-500 text-ink-950'
          : plan.tier === 'plata'
            ? 'bg-brand-600 text-white'
            : 'bg-ink-900 text-white',
      ]}>
      {plan.badge}
    </span>
  )}
  <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-600">
    {plan.kicker}
  </p>
  <h3 class="mt-1 font-display font-bold text-xl">{plan.name}</h3>
  <div class="mt-3 flex items-center gap-2.5 min-h-[2.75rem]">
    <span
      class:list={[
        'inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-base font-bold',
        identidad.chip,
      ]}
      aria-hidden="true">
      <Icon name={identidad.icono} size={17} />
    </span>
    <div>
      <p class:list={['font-display font-extrabold leading-tight text-ink-900', precioLargo ? 'text-lg' : 'text-2xl']}>
        {plan.priceLabel}
      </p>
      {plan.annualLabel && (
        <p class="text-xs font-semibold text-emerald-700">{plan.annualLabel}</p>
      )}
    </div>
  </div>
  <p class="mt-2 text-sm text-slate-600">{plan.description}</p>
  {herencia && (
    <p class="mt-4 rounded-lg bg-ink-50 px-3 py-2 text-xs font-semibold text-slate-600">
      ＋ {herencia}
    </p>
  )}
  <ul class="mt-4 space-y-2.5 text-sm flex-1 border-t border-ink-100 pt-4">
    {
      beneficios.map((f) => (
        <li class="flex gap-2">
          <span class="text-emerald-500 font-bold" aria-hidden="true">✓</span>
          <span>{f}</span>
        </li>
      ))
    }
    {
      plan.limitations?.map((l) => (
        <li class="flex gap-2 text-slate-600">
          <span aria-hidden="true">–</span>
          <span>{l}</span>
        </li>
      ))
    }
  </ul>
  <a
    href={`/publicar?plan=${plan.tier}`}
    data-event="elegir_plan"
    data-props={JSON.stringify({ plan: plan.tier })}
    class:list={[
      'mt-6 flex w-full items-center justify-center gap-1.5 px-4 py-3.5 rounded-xl text-sm font-bold transition active:scale-[0.98]',
      destacado
        ? 'bg-ink-950 text-white hover:bg-ink-800 shadow-lg'
        : plan.tier === 'plata'
          ? 'bg-brand-600 text-white hover:bg-brand-700 shadow'
          : 'bg-white text-ink-900 border-2 border-ink-200 hover:border-ink-900',
    ]}>
    {plan.cta} <Icon name="arrow-right" size={15} />
  </a>
  <p class="mt-2.5 text-xs text-slate-500 text-center">
    {esGratis ? 'Gratis para siempre · Sin tarjeta' : 'Sin tarjeta · Sin permanencia'}
  </p>
</article>
