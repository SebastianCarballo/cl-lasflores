---
import type { Plan } from '@/types';
import Icon from '@/components/Icon.astro';

interface Props {
  plan: Plan;
}
const { plan } = Astro.props;
const destacado = plan.highlighted;
const esGratis = plan.tier === 'gratis';
// Precios promo largos ("Gratis x 30 días, luego…") en cuerpo menor para no romper la card.
const precioLargo = plan.priceLabel.length > 16;
---

<article
  class:list={[
    'relative rounded-3xl border p-7 pt-8 flex flex-col bg-white transition hover:-translate-y-1 hover:shadow-xl',
    destacado
      ? 'border-2 border-amber-400 ring-4 ring-amber-400/20 shadow-2xl lg:scale-[1.03]'
      : 'border-ink-200 shadow-sm',
  ]}>
  {plan.badge && (
    <span
      class:list={[
        'absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full text-[11px] font-extrabold uppercase tracking-wide whitespace-nowrap shadow-lg',
        destacado ? 'bg-gradient-to-r from-amber-400 to-yellow-500 text-ink-950' : 'bg-ink-900 text-white',
      ]}>
      {plan.badge}
    </span>
  )}
  <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">
    {esGratis ? 'Para empezar' : 'Lanzamiento'}
  </p>
  <h3 class="mt-1 font-display font-bold text-xl">{plan.name}</h3>
  <div class="mt-3 flex items-center gap-2.5 min-h-[2.75rem]">
    <span
      class:list={[
        'inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-base font-bold',
        destacado ? 'bg-amber-400/25 text-amber-600' : esGratis ? 'bg-ink-100 text-ink-500' : 'bg-brand-100 text-brand-700',
      ]}
      aria-hidden="true">
      {destacado ? '★' : esGratis ? '○' : '✓'}
    </span>
    <p class:list={['font-display font-extrabold leading-tight text-ink-900', precioLargo ? 'text-lg' : 'text-2xl']}>
      {plan.priceLabel}
    </p>
  </div>
  <p class="mt-2 text-sm text-slate-600">{plan.description}</p>
  <ul class="mt-5 space-y-2.5 text-sm flex-1 border-t border-ink-100 pt-5">
    {
      plan.features.map((f) => (
        <li class="flex gap-2">
          <span class="text-emerald-500 font-bold" aria-hidden="true">✓</span>
          <span>{f}</span>
        </li>
      ))
    }
    {
      plan.limitations?.map((l) => (
        <li class="flex gap-2 text-slate-400">
          <span aria-hidden="true">–</span>
          <span>{l}</span>
        </li>
      ))
    }
  </ul>
  <a
    href={`/publicar?plan=${plan.tier}`}
    data-event="elegir_plan"
    data-props={JSON.stringify({ plan: plan.tier })}
    class:list={[
      'mt-6 flex w-full items-center justify-center gap-1.5 px-4 py-3.5 rounded-xl text-sm font-bold transition active:scale-[0.98]',
      destacado
        ? 'bg-ink-950 text-white hover:bg-ink-800 shadow-lg'
        : 'bg-white text-ink-900 border-2 border-ink-200 hover:border-ink-900',
    ]}>
    {plan.cta} <Icon name="arrow-right" size={15} />
  </a>
  <p class="mt-2.5 text-xs text-slate-500 text-center">
    {esGratis ? 'Gratis para siempre · Sin tarjeta' : 'Sin tarjeta · Sin permanencia'}
  </p>
</article>
