---
import { listCategories } from '@/data/categories';
import Icon from '@/components/Icon.astro';
import Newsletter from '@/components/Newsletter.astro';
import { STUDIO } from '@/utils/site';

// URL del estudio creador — fuente única en utils/site.ts (STUDIO.url).
const STUDIO_URL = STUDIO.url;

const categories = await listCategories();
---

<footer class="bg-ink-950 text-slate-300 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14 grid gap-10 md:grid-cols-4">
    <div>
      <div class="flex items-center gap-2.5 mb-4">
        <img src="/logo-flores.webp" alt="" width="112" height="112" loading="lazy" decoding="async" class="h-9 w-9 rounded-lg bg-white object-contain" />
        <span class="font-display font-bold text-white">Clasificados Las Flores</span>
      </div>
      <p class="text-sm leading-relaxed text-slate-400">
        El directorio de Las Flores, Buenos Aires. Conectamos vecinos con comercios,
        oficios y emprendedores locales.
      </p>
      <p class="mt-4 text-xs text-slate-400">Hecho con ♥ en Las Flores</p>
      <a
        href={STUDIO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-3 hover:bg-white/10 hover:border-white/20 transition-colors"
        aria-label="Sitio web creado por MembyStudio">
        <span class="leading-tight">
          <span class="block text-xs text-slate-400">Sitio web creado por</span>
          <img src="/memby-studio.webp" alt="MembyStudio" width="482" height="112" loading="lazy" decoding="async" class="mt-1.5 h-8 w-auto" />
        </span>
      </a>
      <a
        href={STUDIO.facebook}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook de MembyStudio"
        class="mt-3 inline-flex items-center gap-2 text-sm text-slate-400 transition hover:text-white">
        <Icon name="facebook" size={16} />
        Facebook de MembyStudio
      </a>
    </div>

    <nav aria-label="Categorías">
      <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Categorías</h3>
      <ul class="space-y-2 text-sm">
        {
          categories.slice(0, 6).map((c) => (
            <li>
              <a href={`/categoria/${c.slug}`} class="hover:text-white transition-colors">
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Empresa">
      <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Plataforma</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="/directorio" class="hover:text-white">Directorio</a></li>
        <li><a href="/planes" class="hover:text-white">Planes y precios</a></li>
        <li><a href="/publicar" class="hover:text-white">Publicar mi negocio</a></li>
        <li><a href="/nosotros" class="hover:text-white">Nosotros</a></li>
        <li><a href="/contacto" class="hover:text-white">Contacto</a></li>
        <li><a href="/privacidad" class="hover:text-white">Privacidad</a></li>
        <li><a href="/terminos" class="hover:text-white">Términos</a></li>
      </ul>
    </nav>

    <div>
      <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Contacto</h3>
      <ul class="space-y-2 text-sm text-slate-300">
        <li>📍 Las Flores, Buenos Aires</li>
        <li>📱 WhatsApp: +54 9 2244 42-8714</li>
        <li class="break-all">✉️ <a href="mailto:clasificadaslasflores@gmail.com" class="hover:text-white transition-colors">clasificadaslasflores@gmail.com</a></li>
      </ul>
      <div class="flex gap-2 mt-4">
        <a href="https://instagram.com/clasificadoslasflores" target="_blank" rel="noopener noreferrer" aria-label="Instagram de Clasificados Las Flores" class="w-11 h-11 rounded-full bg-white/10 grid place-items-center hover:bg-white/20 hover:scale-105 active:scale-95 transition"><Icon name="instagram" size={17} /></a>
        <a href="https://facebook.com/clasificadolasfloresok" target="_blank" rel="noopener noreferrer" aria-label="Facebook de Clasificados Las Flores" class="w-11 h-11 rounded-full bg-white/10 grid place-items-center hover:bg-white/20 hover:scale-105 active:scale-95 transition"><Icon name="facebook" size={17} /></a>
        <a href="https://wa.me/5492244428714" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp de Clasificados Las Flores" class="w-11 h-11 rounded-full bg-white/10 grid place-items-center hover:bg-white/20 hover:scale-105 active:scale-95 transition"><Icon name="whatsapp" size={17} /></a>
      </div>
    </div>
  </div>

  {/* Newsletter: banda propia y horizontal. Es el CTA de suscripción, no un link más del footer. */}
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 grid gap-6 lg:grid-cols-2 items-center">
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-2">Newsletter</h3>
        <p class="text-sm text-slate-300">
          Una vez por semana contás qué negocios se suman, qué buscan los vecinos
          y qué queda de nuevo publicado en el directorio. Sin spam, y te podés
          dar de baja cuando quieras.
        </p>
      </div>
      <Newsletter />
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 flex flex-col sm:flex-row justify-between gap-2 text-xs text-slate-400">
      <p>© 2026 Clasificados Las Flores by <a href={STUDIO_URL} target="_blank" rel="noopener noreferrer" class="text-slate-300 font-semibold hover:text-white transition-colors">MembyStudio</a>. Todos los derechos reservados.</p>
      <p>Hecho en Las Flores para Las Flores</p>
    </div>
  </div>
</footer>
