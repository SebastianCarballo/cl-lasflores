---
import Icon from '@/components/Icon.astro';
---

<div id="asistente" class="contents">
  <button
    type="button"
    id="asistente-btn"
    aria-expanded="false"
    aria-controls="asistente-panel"
    aria-label="Abrir asistente virtual"
    class="fixed z-[60] bottom-24 right-4 lg:bottom-6 lg:right-6 w-14 h-14 rounded-full bg-ink-950 text-white grid place-items-center shadow-2xl hover:scale-105 active:scale-95 transition-transform">
    <span class="absolute -top-0.5 -right-0.5 flex w-3.5 h-3.5" aria-hidden="true">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-400 border-2 border-white"></span>
    </span>
    <Icon name="whatsapp" size={26} />
  </button>

  <div
    id="asistente-panel"
    role="dialog"
    aria-modal="false"
    aria-label="Asistente virtual de Clasificados Las Flores"
    hidden
    class="fixed z-[60] inset-x-4 bottom-40 lg:inset-x-auto lg:right-6 lg:bottom-24 lg:w-[380px] bg-white rounded-3xl border border-ink-100 shadow-2xl overflow-hidden flex flex-col max-h-[62vh]">
    <div class="bg-ink-950 text-white px-5 py-4 flex items-center gap-3">
      <span class="w-10 h-10 rounded-2xl bg-white grid place-items-center shrink-0" aria-hidden="true"><img src="/logo-flores.webp" alt="" width="112" height="112" loading="lazy" decoding="async" class="h-9 w-9 rounded-xl object-contain" /></span>
      <div class="flex-1 leading-tight">
        <p class="font-display font-bold text-[15px]">Flor 🌸 · Asistente virtual</p>
        <p class="text-xs text-emerald-300">● En línea · te respondo al toque</p>
      </div>
      <button type="button" id="asistente-cerrar" aria-label="Cerrar asistente" class="w-9 h-9 rounded-full hover:bg-white/10 grid place-items-center text-xl leading-none"><span aria-hidden="true">×</span></button>
    </div>

    <div id="asistente-msgs" class="flex-1 overflow-y-auto px-4 py-4 space-y-3 text-sm" aria-live="polite"></div>

    <div class="px-4 pb-2 flex flex-wrap gap-2" id="asistente-rapidos">
      <button type="button" data-rapido="oro" class="px-3 py-2 rounded-full bg-ink-100 text-xs font-semibold hover:bg-ink-200 transition">🥇 Vidriera Digital</button>
      <button type="button" data-rapido="cuánto cuesta publicar" class="px-3 py-2 rounded-full bg-ink-100 text-xs font-semibold hover:bg-ink-200 transition">💰 Planes y precios</button>
      <button type="button" data-rapido="quiero publicar mi negocio" class="px-3 py-2 rounded-full bg-ink-100 text-xs font-semibold hover:bg-ink-200 transition">📢 Quiero publicar</button>
    </div>

    <form id="asistente-form" class="p-3 border-t border-ink-100 flex gap-2">
      <label class="sr-only" for="asistente-input">Escribí tu pregunta</label>
      <input
        id="asistente-input"
        type="text"
        autocomplete="off"
        enterkeyhint="send"
        placeholder="Ej: busco empanadas…"
        class="flex-1 min-w-0 px-4 py-3 rounded-xl bg-ink-100 outline-none focus:ring-2 focus:ring-brand-500 text-sm"
      />
      <button type="submit" aria-label="Enviar pregunta" class="w-12 h-12 shrink-0 rounded-xl bg-brand-600 text-white grid place-items-center hover:bg-brand-700 active:scale-95 transition">
        <Icon name="arrow-right" size={18} />
      </button>
    </form>
  </div>

  <script>
    import { track } from '@/utils/analytics';

    interface Negocio {
      slug: string; nombre: string; categoria: string; cat: string; resumen: string;
      direccion: string; horarios: string; plan: string;
      verificado: boolean; wa: string | null; telefono: string;
      haystack: string; catalogo?: { nombre: string; precio: string }[];
    }

    const ASESOR = '5492224000000';
    // El índice vive en /bot-index.json (generado en build) y se pide solo al abrir.
    let datos: { negocios: Negocio[]; categorias: { slug: string; nombre: string }[] } | null = null;
    let cargando: Promise<void> | null = null;
    function asegurarDatos(): Promise<void> {
      if (datos) return Promise.resolve();
      if (!cargando) {
        cargando = fetch('/bot-index.json')
          .then((r) => {
            if (!r.ok) throw new Error('bot-index');
            return r.json();
          })
          .then((j) => {
            datos = j;
          })
          .catch(() => {
            datos = { negocios: [], categorias: [] };
          });
      }
      return cargando;
    }
    const PLAN_ORDEN: Record<string, number> = { oro: 0, plata: 1, bronce: 2, gratis: 3 };
    const norm = (s: string): string => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const STOP = new Set('de la el en y a los las un una para con por qué que busco buscar necesito quiero hay tiene tienen algún alguna donde como cuál cuáles cuándo mi'.split(' '));

    // El índice vive en /bot-index.json (generado en build) y se pide solo al abrir.
    const panel = document.getElementById('asistente-panel');
    const btn = document.getElementById('asistente-btn') as HTMLButtonElement | null;
    const msgs = document.getElementById('asistente-msgs');
    const form = document.getElementById('asistente-form') as HTMLFormElement | null;
    const input = document.getElementById('asistente-input') as HTMLInputElement | null;
    let saludado = false;

    const waLink = (tel: string, texto: string): string =>
      `https://wa.me/${tel.replace(/\D/g, '')}?text=${encodeURIComponent(texto)}`;

    // Escape para interpolar datos en HTML (texto y atributos entre comillas dobles).
    const esc = (s: string): string =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    function burbuja(de: 'bot' | 'yo', html: string): void {
      if (!msgs) return;
      const d = document.createElement('div');
      d.className =
        de === 'bot'
          ? 'bg-ink-100 rounded-2xl rounded-tl-md px-4 py-3 leading-relaxed'
          : 'bg-brand-600 text-white rounded-2xl rounded-tr-md px-4 py-3 ml-10 leading-relaxed';
      d.innerHTML = html;
      msgs.appendChild(d);
      msgs.scrollTop = msgs.scrollHeight;
    }

    function tarjeta(n: Negocio): string {
      const ficha = `/comercio/${esc(n.slug)}`;
      const contacto = n.wa
        ? `<a href="${waLink(n.wa, `Hola ${n.nombre}, vi tu perfil en Clasificados Las Flores y quiero consultar por…`)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 mt-2 px-3 py-2 rounded-lg bg-[#25D366] text-white text-xs font-bold">WhatsApp directo</a>`
        : `<a href="${ficha}" class="inline-flex items-center mt-2 px-3 py-2 rounded-lg bg-ink-900 text-white text-xs font-bold">Ver perfil</a>`;
      return `<div class="mt-2 rounded-xl bg-white border border-ink-100 p-3">
        <p class="font-bold"><a href="${ficha}" class="hover:underline">${esc(n.nombre)}</a>
        ${n.verificado ? ' <span class="text-[10px] font-bold bg-ink-900 text-white px-1.5 py-0.5 rounded-full align-middle">✓</span>' : ''}</p>
        <p class="text-xs text-slate-600 mt-0.5">${esc(n.resumen)}</p>
        <p class="text-xs text-slate-500 mt-1">${esc(n.categoria)} · ${esc(n.direccion)}</p>
        ${contacto}</div>`;
    }

    function lista(): Negocio[] {
      return datos?.negocios ?? [];
    }

    // Singularización ingenua para que "plomeros" matchee "plomero", "pizzas" → "pizza".
    function variantes(w: string): string[] {
      const out = [w];
      if (w.endsWith('es') && w.length > 4) out.push(w.slice(0, -2));
      else if (w.endsWith('s') && w.length > 3) out.push(w.slice(0, -1));
      return out;
    }

    function buscar(texto: string): Negocio[] {
      const words = norm(texto).split(/\s+/).filter((w) => w.length > 2 && !STOP.has(w));
      if (!words.length) return [];
      return lista()
        .map((n) => {
          const hay = norm(n.haystack);
          const score = words.filter((w) => variantes(w).some((v) => hay.includes(v))).length;
          return { n, score };
        })
        .filter((e) => e.score > 0)
        .sort((a, b) => b.score - a.score || PLAN_ORDEN[a.n.plan] - PLAN_ORDEN[b.n.plan] || a.n.nombre.localeCompare(b.n.nombre))
        .slice(0, 3)
        .map((e) => e.n);
    }

    // Alias rubro → categoría: "comida" debe encontrar la gastronomía aunque
    // la palabra exacta no esté en la ficha.
    const ALIAS: Record<string, string> = {
      comida: 'gastronomia', comer: 'gastronomia', restaurante: 'gastronomia',
      parrilla: 'gastronomia', cena: 'gastronomia', almuerzo: 'gastronomia',
      auto: 'vehiculos', autos: 'vehiculos', moto: 'vehiculos',
      ropa: 'comercios', comprar: 'comercios', tienda: 'comercios',
      trabajo: 'empleo', empleo: 'empleo',
      farmacia: 'salud', medico: 'salud', salud: 'salud',
      curso: 'educacion', ingles: 'educacion', clases: 'educacion',
      casa: 'inmuebles', alquiler: 'inmuebles', departamento: 'inmuebles',
      plomero: 'servicios', electricista: 'servicios', gasista: 'servicios',
    };

    function porAlias(texto: string): Negocio[] {
      const words = norm(texto).split(/\s+/);
      const cat = words.map((w) => ALIAS[w]).find(Boolean);
      if (!cat) return [];
      return lista()
        .filter((n) => n.cat === cat)
        .sort((a, b) => PLAN_ORDEN[a.plan] - PLAN_ORDEN[b.plan] || a.nombre.localeCompare(b.nombre))
        .slice(0, 3);
    }

    function destacados(n = 2): Negocio[] {
      return [...lista()].sort((a, b) => PLAN_ORDEN[a.plan] - PLAN_ORDEN[b.plan] || a.nombre.localeCompare(b.nombre)).slice(0, n);
    }

    function mencionar(texto: string): Negocio | null {
      const t = norm(texto);
      return lista().find((n) => norm(n.nombre).split(/\s+/).some((w) => w.length > 4 && t.includes(w))) ?? null;
    }

    function responder(texto: string): void {
      const t = norm(texto);

      if (/^(hola|buenas|hey|holis|buen[oa]s (dias|tardes|noches)|que tal|saludos)\b/.test(t)) {
        burbuja('bot', '¡Hola! Soy <strong>Flor</strong> 🌸, la asistente de Clasificados Las Flores. Probá con algo concreto, por ejemplo:<br>· <em>"cuánto sale la Vidriera"</em><br>· <em>"quiero publicar mi negocio"</em><br>· <em>"busco plomero"</em>');
        track('bot_pregunta', { intent: 'saludo' });
        return;
      }
      if (/gracias/.test(t)) {
        burbuja('bot', '¡De nada! 😊 Si necesitás algo más, acá estoy. Y si preferís hablar con una persona: ' + asesorBtn());
        track('bot_pregunta', { intent: 'gracias' });
        return;
      }
      if (/publicar|mi negocio|mi local|mi comercio|emprendimiento|anunciar|pauta|vender (mi|mis)|sumar (mi|un)/.test(t)) {
        burbuja(
          'bot',
          '¡Buenísimo! Publicar te lleva pocos minutos. Tenés 4 planes: <strong>Gratis ($0)</strong> para probar, <strong>Contacto Directo ($5.000/mes)</strong> con botón a WhatsApp, <strong>Comercio Verificado ($12.000/mes)</strong> con sello y catálogo, y <strong>Vidriera Digital ($20.000/mes)</strong> con lugar destacado en el inicio.<br><a href="/planes" class="font-bold text-brand-700 underline">Ver planes</a> · <a href="/publicar" class="font-bold text-brand-700 underline">Empezar gratis</a>',
        );
        track('bot_pregunta', { intent: 'publicar' });
        return;
      }
      // Detalle por plan mencionado (Carlos ya viene con idea: cerrar el funnel)
      const tier = /\b(vidriera|oro)\b/.test(t) ? 'oro' : /\b(verificado|plata)\b/.test(t) ? 'plata' : /\b(bronce|contacto)\b/.test(t) ? 'bronce' : /\bgratis\b/.test(t) ? 'gratis' : null;
      if (tier && /plan|precio|cuesta|publicar|negocio|local|comercio|conviene|diferencia|vidriera|verificado|contacto/.test(t)) {
        const detalle: Record<string, string> = {
          oro: 'La <strong>Vidriera Digital ($20.000/mes)</strong> te pone primero en tu rubro: lugar destacado en el inicio, distintivo dorado, sello Verificado y difusión en nuestras redes. Cupos limitados por rubro.',
          plata: 'El <strong>Comercio Verificado ($12.000/mes)</strong> te da sello Verificado, galería, catálogo, mapa, redes vinculadas e informe mensual de consultas. Ideal si tenés local y querés reputación.',
          bronce: 'El <strong>Contacto Directo ($5.000/mes)</strong> te da botón directo a WhatsApp con mensaje ya redactado y hasta 3 fotos. Ideal para oficios que viven del contacto.',
          gratis: 'El <strong>Gratis ($0)</strong> te da presencia básica con 1 foto. Ideal para probar sin compromiso.',
        };
        const tierPath = tier === 'gratis' ? '' : `?plan=${tier}`;
        burbuja('bot', `${detalle[tier]} <a href="/publicar${tierPath}" class="font-bold text-brand-700 underline">Empezar ahora</a> · <a href="/planes" class="font-bold text-brand-700 underline">Compará planes</a>`);
        track('bot_pregunta', { intent: 'plan_detalle' });
        return;
      }
      if (/plan|precio|costo|cuesta|vale|tarifa/.test(t)) {
        burbuja(
          'bot',
          'Los planes son: <strong>Gratis $0</strong> para siempre, <strong>Contacto Directo $5.000/mes</strong>, <strong>Comercio Verificado $12.000/mes</strong> y <strong>Vidriera Digital $20.000/mes</strong> (los pagos tienen opción anual con 2 meses gratis, sin permanencia). <a href="/planes" class="font-bold text-brand-700 underline">Comparalos acá</a>',
        );
        track('bot_pregunta', { intent: 'planes' });
        return;
      }
      if (/categor/.test(t)) {
        const listaCats = (datos?.categorias ?? []).map((c) => `<a href="/categoria/${esc(c.slug)}" class="font-semibold text-brand-700 underline">${esc(c.nombre)}</a>`).join(' · ');
        burbuja('bot', `Trabajamos estas categorías: ${listaCats || '…cargando'}. ¿Cuál te interesa?`);
        track('bot_pregunta', { intent: 'categorias' });
        return;
      }

      const m = mencionar(texto);
      if (m && /horario|hora|abre|cierra|atiende/.test(t)) {
        burbuja('bot', `<strong>${esc(m.nombre)}</strong> atiende: ${esc(m.horarios)}. 📍 ${esc(m.direccion)}`);
        track('bot_pregunta', { intent: 'horarios' });
        return;
      }
      if (m && /direcci|donde queda|ubicaci|como llego/.test(t)) {
        burbuja('bot', `<strong>${esc(m.nombre)}</strong> está en ${esc(m.direccion)}. <a href="/comercio/${esc(m.slug)}" class="font-bold text-brand-700 underline">Ver ficha y mapa</a>`);
        track('bot_pregunta', { intent: 'direccion' });
        return;
      }
      if (m && /telefono|llamar|whatsapp|contacto|contactar|hablar|numero|escrib/.test(t)) {
        burbuja(
          'bot',
          m.wa
            ? `Hablá directo con <strong>${esc(m.nombre)}</strong>: <a href="${waLink(m.wa, `Hola ${m.nombre}, vi tu perfil en Clasificados Las Flores y quiero consultar por…`)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-1 px-3 py-2 rounded-lg bg-[#25D366] text-white text-xs font-bold">WhatsApp directo</a>`
            : `<strong>${esc(m.nombre)}</strong> no tiene WhatsApp directo. Llamalo al <a href="tel:+${m.telefono.replace(/\D/g, '')}" class="font-bold text-brand-700">+${esc(m.telefono)}</a> o <a href="/comercio/${esc(m.slug)}" class="font-bold text-brand-700 underline">mirá su ficha</a>`,
        );
        track('bot_pregunta', { intent: 'contacto_negocio' });
        return;
      }
      if (m && /precio|cuesta|sale|vale|cuanto|tarifa|costo/.test(t)) {
        if (m.catalogo && m.catalogo.length) {
          const items = m.catalogo.map((it) => `· ${esc(it.nombre)}: <strong>${esc(it.precio)}</strong>`).join('<br>');
          burbuja(
            'bot',
            `Precios de <strong>${esc(m.nombre)}</strong> (a confirmar):<br>${items}<br><a href="/comercio/${esc(m.slug)}" class="font-bold text-brand-700 underline">Ver catálogo completo</a>`,
          );
        } else {
          burbuja(
            'bot',
            `<strong>${esc(m.nombre)}</strong> no publica precios. Te conviene consultar directo: ` +
              (m.wa
                ? `<a href="${waLink(m.wa, `Hola ${m.nombre}, vi tu perfil en Clasificados Las Flores y quiero consultar precios`)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-1 px-3 py-2 rounded-lg bg-[#25D366] text-white text-xs font-bold">WhatsApp directo</a>`
                : `<a href="/comercio/${esc(m.slug)}" class="font-bold text-brand-700 underline">Ver ficha</a>`),
          );
        }
        track('bot_pregunta', { intent: 'precios_negocio' });
        return;
      }
      if (/telefono|whatsapp general|asesor|humano|persona|ayuda/.test(t) && !m) {
        burbuja('bot', `Hablá con nuestro equipo: ${asesorBtn()}`);
        track('bot_pregunta', { intent: 'asesor' });
        return;
      }

      const urgente = /urgente|urgencia|emergencia|ya\b|ahora mismo|rapido|inmediato/.test(t);
      let res = buscar(texto);
      let viaAlias = false;
      if (!res.length) {
        res = porAlias(texto);
        viaAlias = res.length > 0;
      }
      if (res.length) {
        // En urgencia primero los que responden directo por WhatsApp (Marta no puede esperar)
        const ordenadas = urgente ? [...res].sort((a, b) => Number(b.wa !== null) - Number(a.wa !== null)) : res;
        const intro = urgente
          ? '⚡ Para urgencias, estos responden directo 👇'
          : viaAlias
            ? `En ${res[0]?.categoria ?? 'ese rubro'} tenemos esto 👇`
            : 'Encontré esto para vos 👇';
        burbuja('bot', `${intro}${ordenadas.map(tarjeta).join('')}<p class="mt-2"><a href="/directorio" class="font-bold text-brand-700 underline">Ver directorio completo</a></p>`);
        track('bot_pregunta', { intent: urgente ? 'buscar_urgente' : viaAlias ? 'buscar_alias' : 'buscar_ok' });
        return;
      }
      burbuja(
        'bot',
        `No lo encontré en el directorio todavía — somos nuevos en Las Flores 😕 Te muestro lo que ya está o te paso con una persona:${destacados().map(tarjeta).join('')}<p class="mt-2">O hablá con nuestro equipo: ${asesorBtn()}</p>`,
      );
      track('bot_pregunta', { intent: 'buscar_vacio' });
    }

    function asesorBtn(): string {
      return `<a href="${waLink(ASESOR, 'Hola, vengo del asistente virtual y necesito ayuda')}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-1 px-3 py-2 rounded-lg bg-[#25D366] text-white text-xs font-bold">Hablar con una persona por WhatsApp</a>`;
    }

    function abrir(): void {
      if (!panel || !btn) return;
      panel.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Cerrar asistente virtual');
      track('bot_open', {});
      void asegurarDatos(); // precarga el índice mientras saluda
      if (!saludado) {
        saludado = true;
        const espera = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ? 0 : 350;
        setTimeout(() => responder('hola'), espera);
      }
      input?.focus();
    }

    function cerrarPanel(): void {
      if (!panel || !btn) return;
      panel.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Abrir asistente virtual');
      btn.focus();
    }

    btn?.addEventListener('click', () => (panel?.hidden ? abrir() : cerrarPanel()));
    document.getElementById('asistente-cerrar')?.addEventListener('click', cerrarPanel);
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && panel && !panel.hidden) cerrarPanel();
    });
    // Las respuestas con datos esperan al índice; el saludo no lo necesita.
    function preguntar(q: string): void {
      burbuja('yo', esc(q));
      void asegurarDatos().then(() => {
        setTimeout(() => responder(q), 200);
      });
    }

    document.querySelectorAll('#asistente-rapidos [data-rapido]').forEach((b) => {
      b.addEventListener('click', () => {
        const q = (b as HTMLElement).dataset.rapido ?? '';
        if (panel?.hidden) abrir();
        preguntar(q);
      });
    });
    form?.addEventListener('submit', (e: Event) => {
      e.preventDefault();
      const q = input?.value.trim() ?? '';
      if (!q) return;
      if (input) input.value = '';
      preguntar(q);
    });
  </script>
</div>
