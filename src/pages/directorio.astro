---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BusinessCard from '@/components/BusinessCard.astro';
import SlotPublicitario from '@/components/SlotPublicitario.astro';
import ModelosPlanes from '@/components/ModelosPlanes.astro';
import Icon from '@/components/Icon.astro';
import { listBusinesses } from '@/data/businesses';
import { listCategories } from '@/data/categories';

const businesses = await listBusinesses();
const categories = await listCategories();

// Nota de arquitectura: con `output: 'static'` esta página se prerenderiza UNA vez
// (sin query params). El filtrado por ?q=/?cat= ocurre 100% en el cliente
// (mejora progresiva: sin JS se ven todos los resultados).
---

<BaseLayout
  title="Directorio de comercios y servicios en Las Flores"
  description="Buscá comercios, oficios, inmuebles, vehículos y empleo en Las Flores, Buenos Aires. Filtros por categoría y contacto directo por WhatsApp."
>
  <section class="bg-ink-950 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
      <h1 class="font-display font-extrabold text-3xl sm:text-5xl tracking-tight">Directorio de Las Flores</h1>
      <p class="mt-2 text-slate-300" aria-live="polite" role="status"><span id="conteo">{businesses.length}</span> <span id="conteo-palabra">{businesses.length === 1 ? 'resultado' : 'resultados'}</span> · ordenados: destacados primero</p>

      <form method="get" role="search" id="form-buscar" data-event="buscar" class="mt-6 bg-white rounded-2xl p-2 flex flex-col md:flex-row gap-2">
        <label class="sr-only" for="q">Buscar</label>
        <input
          id="q" name="q" type="search" inputmode="search" enterkeyhint="search"
          placeholder="Buscar: plomero, pizza, alquiler…"
          autocomplete="off"
          class="flex-1 px-4 py-3 rounded-xl text-ink-900 outline-none"
        />
        <label class="sr-only" for="cat">Categoría</label>
        <select id="cat" name="cat" class="px-4 py-3 rounded-xl text-ink-900 bg-ink-100 font-medium">
          <option value="todas">Todas las categorías</option>
          {categories.map((c) => <option value={c.slug}>{c.name}</option>)}
        </select>
        <button type="submit" class="px-6 py-3 rounded-xl bg-brand-600 font-bold hover:bg-brand-700 active:scale-[0.98] transition inline-flex items-center justify-center gap-2"><Icon name="search" size={17} /> Buscar</button>
      </form>

      <div class="mt-3 flex flex-wrap gap-2" aria-label="Filtros rápidos" id="filtros-rapidos">
        <a href="/directorio" data-cat-link="todas" class="px-4 py-2.5 rounded-full text-xs font-semibold border bg-white text-ink-900">Todas</a>
        {
          categories.map((c) => (
            <a
              href={`/directorio?cat=${c.slug}`}
              data-cat-link={c.slug}
              class="px-4 py-2.5 rounded-full text-xs font-semibold border bg-white/10 border-white/15 text-white">
              {c.icon} {c.name}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    {/* HMW1/HMW4: el sistema se explica solo — nadie debería adivinar qué es "Vidriera Digital" o "Verificado" */}
    <ul class="mb-6 flex flex-wrap gap-x-5 gap-y-2 text-xs text-slate-600" aria-label="Qué significan las insignias">
      <li><span class="font-bold text-ink-900">✓ Verificado</span> — identidad y dirección confirmadas</li>
      <li><span class="font-bold text-amber-600">★ Vidriera Digital</span> — espacio destacado pago</li>
    </ul>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" id="resultados">
      {businesses.map((b) => <BusinessCard business={b} />)}
    </div>
    {/* Espacios libres: solo sin filtros (al filtrar se ocultan por JS) */}
    <div id="slots-directorio" class="mt-5 grid sm:grid-cols-2 gap-5">
      <SlotPublicitario titulo="Tu negocio acá" texto="El directorio de Las Flores, en un solo lugar. Mostrá tu negocio." />
      <SlotPublicitario titulo="Tu negocio acá" texto="Gratis, sin tarjeta y con contacto directo a tu WhatsApp." />
    </div>
    <div class="mt-8 rounded-3xl bg-ink-950 text-white p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center gap-4 justify-between">
      <div>
        <h2 class="font-display font-bold text-xl">¿No encontrás tu rubro?</h2>
        <p class="text-sm text-slate-300 mt-1">Publicá gratis y aparecé acá mismo.</p>
      </div>
      <a href="/publicar" data-event="cta_publicar" class="shrink-0 inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white text-ink-900 font-bold text-sm hover:bg-brand-50 active:scale-[0.98] transition">Publicar mi negocio <Icon name="arrow-right" size={15} /></a>
    </div>
    <ModelosPlanes />
    <div id="sin-resultados" hidden class="text-center py-16 bg-white rounded-3xl border border-ink-100">
      <p class="text-4xl mb-3" aria-hidden="true">🔍</p>
      <h2 class="font-display font-bold text-xl">No encontramos nada</h2>
      <p class="text-slate-600 mt-2">Probá con otra palabra o <a class="text-brand-700 font-semibold underline" href="/directorio" id="limpiar">limpiá los filtros</a>.</p>
      <a href="/publicar" class="mt-5 inline-flex px-5 py-3 rounded-xl bg-ink-900 text-white text-sm font-bold">¿Tu negocio hace esto? Publicalo gratis</a>
    </div>

    <script type="application/json" id="businesses-index" set:html={JSON.stringify(businesses.map(b => ({ slug: b.slug, category: b.category, haystack: `${b.name} ${b.shortDescription} ${b.description} ${b.tags.join(' ')} ${b.address}` }))).replace(/</g, '\\u003c')} />
    <script>
      import autoAnimate from '@formkit/auto-animate';
      const norm = (s: string): string => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      const params = new URLSearchParams(location.search);
      const input = document.getElementById('q') as HTMLInputElement | null;
      const select = document.getElementById('cat') as HTMLSelectElement | null;
      const grid = document.getElementById('resultados');
      const empty = document.getElementById('sin-resultados');
      const slots = document.getElementById('slots-directorio');
      const conteo = document.getElementById('conteo');
      const quickLinks = Array.from(document.querySelectorAll('[data-cat-link]')) as HTMLAnchorElement[];
      interface IndexEntry { slug: string; category: string; haystack: string }
      const index: IndexEntry[] = JSON.parse(document.getElementById('businesses-index')?.textContent ?? '[]');
      const bySlug = new Map(index.map((e) => [e.slug, e]));
      const validCategories = new Set(index.map((entry) => entry.category));

      const ACTIVE = ['px-4','py-2.5','rounded-full','text-xs','font-semibold','border','bg-white','text-ink-900'];
      const IDLE = ['px-4','py-2.5','rounded-full','text-xs','font-semibold','border','bg-white/10','border-white/15','text-white'];

      // Orden canónico capturado una vez (las filtradas salen del DOM y deben volver)
      const todas: Element[] = grid ? Array.from(grid.querySelectorAll('[data-business-card]')) : [];
      if (grid) autoAnimate(grid);

      function apply(cat: string, qRaw: string, { push = false }: { push?: boolean } = {}) {
        const q = norm((qRaw ?? '').trim());
        const words = q ? q.split(/\s+/).filter((w) => w.length > 0) : [];
        const visibles: Element[] = [];
        todas.forEach((card) => {
          const el = card as HTMLElement;
          const slug = el.getAttribute('data-slug') ?? '';
          const entry = bySlug.get(slug);
          const okCat = !cat || cat === 'todas' || entry?.category === cat;
          const hay = norm(entry?.haystack ?? el.textContent ?? '');
          const okQ = words.length === 0 || words.every((w: string) => hay.includes(w));
          if (okCat && okQ) visibles.push(card);
        });
        // Reinsertar solo visibles: mutación de childList → auto-animate hace FLIP
        if (grid) grid.replaceChildren(...visibles);
        const visible = visibles.length;
        if (conteo) conteo.textContent = String(visible);
        const palabra = document.getElementById('conteo-palabra');
        if (palabra) palabra.textContent = visible === 1 ? 'resultado' : 'resultados';
        if (empty) empty.hidden = visible !== 0;
        if (grid) grid.style.display = visible === 0 ? 'none' : '';
        // Los slots publicitarios solo existen sin filtros (búsqueda honesta)
        if (slots) slots.hidden = !((cat || 'todas') === 'todas' && !(qRaw ?? '').trim());
        quickLinks.forEach((a) => {
          const on = a.getAttribute('data-cat-link') === (cat || 'todas');
          a.classList.remove(...ACTIVE, ...IDLE);
          a.classList.add(...(on ? ACTIVE : IDLE));
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
        if (push) {
          const next = new URLSearchParams();
          if (qRaw) next.set('q', qRaw);
          if (cat && cat !== 'todas') next.set('cat', cat);
          history.replaceState(null, '', next.size ? `/directorio?${next}` : '/directorio');
        }
      }

      const initialQ = params.get('q') ?? '';
      const initialCatRaw = params.get('cat') ?? 'todas';
      const initialCat = initialCatRaw === 'todas' || validCategories.has(initialCatRaw) ? initialCatRaw : 'todas';

      function syncFromUrl() {
        const current = new URL(location.href);
        const q = current.searchParams.get('q') ?? '';
        const catRaw = current.searchParams.get('cat') ?? 'todas';
        const cat = catRaw === 'todas' || validCategories.has(catRaw) ? catRaw : 'todas';
        if (input) input.value = q;
        if (select) select.value = cat;
        apply(cat, q);
      }

      if (input) input.value = initialQ;
      if (select) select.value = initialCat;
      apply(initialCat, initialQ);

      let t: ReturnType<typeof setTimeout>;
      input?.addEventListener('input', () => {
        clearTimeout(t);
        t = setTimeout(() => apply(select?.value ?? 'todas', input.value, { push: true }), 120);
      });
      select?.addEventListener('change', () => apply(select.value, input?.value ?? '', { push: true }));
      document.getElementById('form-buscar')?.addEventListener('submit', (e: Event) => {
        e.preventDefault();
        apply(select?.value ?? 'todas', input?.value ?? '', { push: true });
      });
      quickLinks.forEach((a) =>
        a.addEventListener('click', (e: Event) => {
          e.preventDefault();
          const cat = a.getAttribute('data-cat-link') ?? 'todas';
          if (select) select.value = cat;
          apply(cat, input?.value ?? '', { push: true });
        }),
      );
      document.getElementById('limpiar')?.addEventListener('click', (e: Event) => {
        e.preventDefault();
        if (input) input.value = '';
        if (select) select.value = 'todas';
        apply('todas', '', { push: true });
      });
      window.addEventListener('popstate', syncFromUrl);
    </script>
  </section>
</BaseLayout>
