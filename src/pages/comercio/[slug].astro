---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BusinessCard from '@/components/BusinessCard.astro';
import SlotPublicitario from '@/components/SlotPublicitario.astro';
import Foto from '@/components/Foto.astro';
import Icon from '@/components/Icon.astro';
import { listBusinesses, getBusiness, getRelated } from '@/data/businesses';
import { getCategory } from '@/data/categories';
import { whatsappLink, localBusinessSchema, breadcrumbSchema, formatPhoneDisplay } from '@/utils/site';

export const prerender = true;

export async function getStaticPaths() {
  const businesses = await listBusinesses();
  return businesses.map((b) => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
const business = await getBusiness(slug ?? '');
if (!business) return Astro.redirect('/404');

const cat = await getCategory(business.category);
const related = await getRelated(business.slug);
const wa =
  business.hasWhatsAppButton && business.whatsapp && business.plan !== 'gratis'
    ? whatsappLink(business.whatsapp, business.name)
    : null;
const ciudad = business.address.toLowerCase().includes('las flores')
  ? business.address
  : `${business.address}, Las Flores, Buenos Aires`;
const schema = [
  localBusinessSchema(business),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Directorio', path: '/directorio' },
    { name: cat?.name ?? 'Categoría', path: `/categoria/${business.category}` },
    { name: business.name, path: `/comercio/${business.slug}` },
  ]),
];
---

<BaseLayout
  title={`${business.name} en Las Flores, Buenos Aires — ${cat?.name}`}
  description={`${business.shortDescription} ${ciudad}. Horarios: ${business.hours}. Contacto directo.`}
  image={business.image}
  imageAlt={`Foto de ${business.name}, ${cat?.name ?? 'comercio'} en Las Flores`}
  type="article"
  publishedTime={business.createdAt}
  schema={schema}
>
  {/* Breadcrumb SEO */}
  <nav aria-label="Miga de pan" class="max-w-7xl mx-auto px-4 sm:px-6 pt-6 text-sm text-slate-500">
    <a href="/directorio" class="inline-flex items-center gap-1.5 font-semibold text-brand-700 hover:underline rounded-lg">
      <span aria-hidden="true">←</span> Volver al directorio
    </a>
    <ol class="mt-2 flex flex-wrap gap-1.5">
      <li><a href="/" class="hover:text-ink-900">Inicio</a> /</li>
      <li><a href="/directorio" class="hover:text-ink-900">Directorio</a> /</li>
      <li><a href={`/categoria/${business.category}`} class="hover:text-ink-900">{cat?.name}</a> /</li>
      <li aria-current="page" class="text-ink-900 font-medium">{business.name}</li>
    </ol>
  </nav>

  <article class="max-w-7xl mx-auto px-4 sm:px-6 py-8 grid lg:grid-cols-3 gap-8">
    {/* Columna principal: primero la info (título, subtítulo, dirección, párrafo), luego la imagen */}
    <div class="lg:col-span-2">
      <div class="bg-white rounded-3xl border border-ink-100 p-6 sm:p-8">
        <div class="flex flex-wrap items-center gap-2 text-sm">
          {business.demo ? (
            <span class="px-2 py-0.5 rounded-full bg-brand-600 text-white text-xs font-bold">MUESTRA</span>
          ) : (
            <span class="px-2 py-0.5 rounded-full bg-ink-100 text-xs font-semibold">{cat?.icon} {cat?.name}</span>
          )}
          <span class="ml-2 px-2 py-0.5 rounded-full bg-ink-100 text-xs font-semibold">{cat?.icon} {cat?.name}</span>
          {business.verified && (business.plan === 'plata' || business.plan === 'oro') && (
            <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">✓ Verificado</span>
          )}
        </div>
        <div class="mt-3 flex items-center gap-4">
          {/* Logo: incluido desde Contacto Directo en adelante (Gratis no tiene) */}
          {business.plan !== 'gratis' && (
            <span
              class="w-14 h-14 shrink-0 rounded-2xl bg-gradient-to-br from-brand-600 to-indigo-600 text-white grid place-items-center font-display font-extrabold text-2xl"
              aria-hidden="true">
              {business.name.charAt(0)}
            </span>
          )}
          <div>
            <h1 class="font-display font-extrabold text-3xl sm:text-4xl tracking-tight text-balance">{business.name}</h1>
            <p class="mt-1 text-lg text-slate-600 font-medium text-pretty">{business.shortDescription}</p>
          </div>
        </div>
        <p class="mt-3 text-sm text-slate-600"><span aria-hidden="true">📍</span> {business.address} · <span aria-hidden="true">🕒</span> {business.hours}</p>
        <p class="ficha-desc mt-4 text-slate-700 leading-relaxed">{business.description}</p>
        <p class="mt-3 text-xs text-slate-500">Ficha publicada el {new Date(business.createdAt + 'T12:00:00').toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })} por Clasificados Las Flores{business.verified ? ' · Datos verificados por nuestro equipo' : ''}.</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {business.tags.map((t) => <span class="px-3 py-1 rounded-full bg-ink-100 text-xs font-medium">#{t}</span>)}
        </div>
      </div>

      <div class="mt-6 relative rounded-3xl overflow-hidden border border-ink-100 shadow-sm bg-ink-100">
        <Foto src={business.image} alt={business.name} widths={[800, 1200]} sizes="(max-width: 1024px) 100vw, 66vw" class="w-full aspect-[16/9] object-cover" loading="eager" decoding="async" fetchpriority="high" />
        <div class="absolute top-4 left-4 flex gap-2">
          {business.plan === 'oro' && <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-gradient-to-r from-amber-400 to-yellow-500">★ VIDRIERA DIGITAL</span>}
          {business.verified && (business.plan === 'plata' || business.plan === 'oro') && (
            <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-ink-950/85 text-white">✓ Comercio Verificado</span>
          )}
        </div>
      </div>

      {business.gallery.length > 1 && (
        <div class="mt-4 flex gap-3 overflow-x-auto snap-x snap-mandatory pb-1 md:grid md:grid-cols-3 md:overflow-visible md:pb-0">
          {business.gallery.map((img, i) => (
            <Foto src={img} alt={`${business.name} foto ${i + 1}`} widths={[300, 600]} sizes="(max-width: 1024px) 33vw, 22vw" loading="lazy" decoding="async" class="rounded-2xl aspect-square object-cover border border-ink-100 w-40 shrink-0 snap-start md:w-auto" />
          ))}
        </div>
      )}

      {/* Catálogo: solo Comercio Verificado y Vidriera Digital con items cargados */}
      {(business.plan === 'plata' || business.plan === 'oro') && business.catalogo && business.catalogo.length > 0 && (
        <section class="mt-6 bg-white rounded-3xl border border-ink-100 p-6 sm:p-8" aria-label={`Catálogo de ${business.name}`}>
          <h2 class="font-display font-bold text-xl">Catálogo</h2>
          <ul class="mt-4 divide-y divide-ink-100">
            {business.catalogo.map((item) => (
              <li class="py-3 flex items-baseline justify-between gap-4">
                <span class="font-medium">{item.nombre}</span>
                <span class="font-display font-bold text-brand-700 whitespace-nowrap">{item.precio}</span>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-xs text-slate-500">Precios de referencia — confirmálos por WhatsApp.</p>
        </section>
      )}

      {related.length > 0 ? (
        <section class="mt-8" aria-label="Relacionados">
          <h2 class="font-display font-bold text-xl mb-4">Seguí explorando tu rubro</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {related.map((b) => <BusinessCard business={b} />)}
          </div>
        </section>
      ) : (
        <section class="mt-8" aria-label="Tu negocio acá">
          <SlotPublicitario titulo="Tu ficha en este rubro" texto="Aparecé en las fichas de tu rubro." plan="oro" />
        </section>
      )}
    </div>

    {/* Sidebar contacto */}
    <aside class="space-y-4 lg:sticky lg:top-24 h-fit">
      <div class="bg-white rounded-3xl border border-ink-100 p-6 shadow-sm">
        <h2 class="font-display font-bold text-lg">Contacto directo</h2>
        {business.demo ? (
          <>
            <a href={business.plan === 'oro' ? '/publicar?plan=oro' : '/publicar'} data-event="slot_publicar" data-props={JSON.stringify({ slug: business.slug, origen: 'ficha-demo' })} class="mt-4 flex items-center justify-center gap-2 px-4 py-3.5 rounded-xl bg-ink-950 text-white font-bold hover:bg-ink-800 active:scale-[0.99] transition btn-sheen">
              {business.plan === 'oro' ? '🥇 Quiero mi Vidriera acá' : 'Empezar gratis con la mía'}
            </a>
            <p class="mt-3 text-xs text-slate-500 text-center">Ficha de muestra — no es un comercio real.</p>
          </>
        ) : wa ? (
          <>
            <a href={wa} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-props={JSON.stringify({ slug: business.slug, plan: business.plan, origen: 'ficha' })} class="mt-4 flex items-center justify-center gap-2 px-4 py-3.5 rounded-xl bg-[#25D366] text-white font-bold hover:brightness-95 active:scale-[0.99] transition btn-sheen">
              <Icon name="whatsapp" size={20} /> Consultar por WhatsApp
            </a>
            <a href={`tel:+${business.phone}`} class="mt-2 flex items-center justify-center gap-2 px-4 py-3 rounded-xl border-2 border-ink-900 text-ink-900 font-bold text-sm hover:bg-ink-900 hover:text-white transition">
              <Icon name="phone" size={16} /> Llamar
            </a>
            {/* HMW1: certeza antes del clic — contacto directo, sin intermediarios */}
            <p class="mt-3 text-xs text-slate-500 text-center">Hablás directo con el negocio, sin intermediarios.</p>
          </>
        ) : (
          <a href={`tel:+${business.phone}`} class="mt-4 flex items-center justify-center gap-2 px-4 py-3.5 rounded-xl bg-ink-900 text-white font-bold">
            📞 Llamar {business.phone}
          </a>
        )}
        <dl class="mt-5 space-y-3 text-sm">
          <div><dt class="font-semibold"><span aria-hidden="true">📍</span> Dirección</dt><dd class="text-slate-600">{business.address}</dd></div>
          <div><dt class="font-semibold"><span aria-hidden="true">🕒</span> Horarios</dt><dd class="text-slate-600">{business.hours}</dd></div>
          <div><dt class="font-semibold"><span aria-hidden="true">📞</span> Teléfono</dt><dd><a class="text-brand-700 font-medium" href={`tel:+${business.phone}`}>{formatPhoneDisplay(business.phone)}</a></dd></div>
        </dl>
        <div class="mt-4 flex gap-2">
          {business.instagram && <a href={business.instagram} target="_blank" rel="noopener noreferrer" aria-label={`IG — Instagram de ${business.name}`} class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-ink-100 text-sm font-semibold hover:bg-ink-200 transition"><Icon name="instagram" size={15} /> IG</a>}
          {business.facebook && <a href={business.facebook} target="_blank" rel="noopener noreferrer" aria-label={`FB — Facebook de ${business.name}`} class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-ink-100 text-sm font-semibold hover:bg-ink-200 transition"><Icon name="facebook" size={15} /> FB</a>}
          {business.website && <a href={business.website} target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-ink-100 text-sm font-semibold hover:bg-ink-200 transition"><Icon name="globe" size={15} /> Web</a>}
        </div>
        <div class="mt-4 pt-4 border-t border-ink-100 flex items-center justify-between gap-2">
          <button
            type="button"
            id="btn-compartir"
            data-event="compartir_ficha"
            data-props={JSON.stringify({ slug: business.slug })}
            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-ink-100 text-sm font-semibold hover:bg-ink-200 transition">
            <Icon name="share" size={15} /> Compartir
          </button>
          <a
            href={`mailto:hola@clasificadoslasflores.com.ar?subject=${encodeURIComponent(`Datos incorrectos: ${business.name}`)}`}
            class="text-xs text-slate-500 hover:text-ink-900 hover:underline">
            ¿Datos incorrectos? Avisanos
          </a>
        </div>
        <script>
          const btn = document.getElementById('btn-compartir') as HTMLButtonElement | null;
          const original = btn?.innerHTML ?? '';
          btn?.addEventListener('click', async () => {
            const url = location.href;
            const title = document.title;
            const nav = navigator as Navigator & { share?: (d: { title: string; url: string }) => Promise<void> };
            try {
              if (nav.share) {
                await nav.share({ title, url });
                return;
              }
              throw new Error('sin Web Share API');
            } catch {
              try {
                await navigator.clipboard.writeText(url);
                btn.textContent = '✓ ¡Enlace copiado!';
              } catch {
                window.open(`https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`, '_blank', 'noopener,noreferrer');
                return;
              }
              setTimeout(() => {
                if (btn) btn.innerHTML = original;
              }, 2000);
            }
          });
        </script>
      </div>

      {/* Mapa interactivo: solo Comercio Verificado y Vidriera Digital con coordenadas */}
      {(business.plan === 'plata' || business.plan === 'oro') &&
        business.latitude !== undefined &&
        business.longitude !== undefined && (
        <div class="bg-white rounded-3xl border border-ink-100 p-6 shadow-sm">
          <h2 class="font-display font-bold text-lg">Ubicación</h2>
          <div
            id="mapa-negocio"
            role="application"
            tabindex="0"
            aria-label={`Mapa de ubicación de ${business.name}. Usá las flechas para explorar.`}
            data-lat={business.latitude}
            data-lng={business.longitude}
            data-name={business.name}
            class="mt-4 h-56 w-full rounded-2xl border border-ink-100 bg-ink-100"
          />
          <a
            href={`https://www.openstreetmap.org/?mlat=${business.latitude}&mlon=${business.longitude}#map=16/${business.latitude}/${business.longitude}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:underline slide-arrow">
            Cómo llegar <Icon name="arrow-right" size={14} />
          </a>
          <link
            rel="stylesheet"
            href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
            integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
            crossorigin=""
          />
          <script
            src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""
            defer
          />
          <script>
            const initMap = () => {
              const el = document.getElementById('mapa-negocio') as HTMLElement | null;
              const L = (window as unknown as { L?: any }).L;
              if (!el || !L) return;
              const lat = Number(el.dataset.lat);
              const lng = Number(el.dataset.lng);
              if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
              const map = L.map(el, { scrollWheelZoom: false }).setView([lat, lng], 15);
              L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
              }).addTo(map);
              L.marker([lat, lng]).addTo(map).bindPopup(el.dataset.name ?? 'Acá estamos');
              el.addEventListener('focus', () => map.scrollWheelZoom.enable(), { once: true });
            };
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', initMap);
            } else {
              initMap();
            }
            window.addEventListener('load', initMap, { once: true });
          </script>
        </div>
      )}

      <div class="rounded-3xl bg-ink-950 text-white p-6">
        <p class="text-xs uppercase tracking-wider text-slate-400 font-bold">¿Es tu negocio?</p>
        <p class="mt-1 text-sm text-slate-300">Reclamalo y pasate a Comercio Verificado o Vidriera Digital para que te encuentren más fácil.</p>
        <a href="/planes" class="mt-3 inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-white text-ink-900 text-sm font-bold hover:bg-brand-50 transition slide-arrow">Ver planes <Icon name="arrow-right" size={15} /></a>
      </div>
    </aside>
  </article>

  {/* CTA fija en móvil: el pulgar llega al contacto sin scroll (CRO) */}
  <div class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur border-t border-ink-100 p-3" style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));">
    {business.demo ? (
      <a href={business.plan === 'oro' ? '/publicar?plan=oro' : '/publicar'} data-event="slot_publicar" data-props={JSON.stringify({ slug: business.slug, origen: 'sticky-demo' })} class="flex items-center justify-center gap-2 w-full px-4 py-3.5 rounded-xl bg-ink-950 text-white font-bold active:scale-[0.99] transition">
        {business.plan === 'oro' ? '🥇 Quiero mi Vidriera acá' : 'Empezar gratis con la mía'}
      </a>
    ) : wa ? (
      <a href={wa} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-props={JSON.stringify({ slug: business.slug, plan: business.plan, origen: 'sticky' })} class="flex items-center justify-center gap-2 w-full px-4 py-3.5 rounded-xl bg-[#25D366] text-white font-bold active:scale-[0.99] transition btn-sheen">
        <Icon name="whatsapp" size={20} /> Consultar por WhatsApp
      </a>
    ) : (
      <a href={`tel:+${business.phone}`} class="flex items-center justify-center gap-2 w-full px-4 py-3.5 rounded-xl bg-ink-900 text-white font-bold">
        <span aria-hidden="true">📞</span> Llamar ahora
      </a>
    )}
  </div>
  {/* Compensa la barra fija para que el footer no quede tapado en móvil */}
  <div class="h-20 lg:hidden" aria-hidden="true"></div>
</BaseLayout>
