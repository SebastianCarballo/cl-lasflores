---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { CONTACT_LIMITS } from '@/utils/contact';
---

<BaseLayout
  title="Contacto"
  description="Contactá con el equipo de Clasificados Las Flores para publicidad, vidriera digital y alianzas locales."
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="font-display font-extrabold text-4xl tracking-tight">Contacto</h1>
    <p class="mt-3 text-slate-600">Publicidad, alianzas, soporte de planes y reportes. Respondemos en el día.</p>
    <div class="mt-8 grid sm:grid-cols-2 gap-4">
      <a href="https://wa.me/5492224000000" target="_blank" rel="noopener noreferrer" class="bg-[#25D366] text-white rounded-2xl p-6 font-bold hover:brightness-95 active:scale-[0.99] transition btn-sheen"><span class="inline-flex items-center gap-2"><Icon name="whatsapp" size={20} /> Escribinos por WhatsApp</span><span class="block text-sm font-normal opacity-90 mt-1">+54 9 2224 00-0000</span></a>
      <a href="mailto:hola@clasificadoslasflores.com.ar" class="bg-ink-950 text-white rounded-2xl p-6 font-bold hover:bg-ink-800 transition"><span class="inline-flex items-center gap-2"><Icon name="mail" size={20} /> Email</span><span class="block text-sm font-normal text-slate-300 mt-1">hola@clasificadoslasflores.com.ar</span></a>
    </div>
    <div class="mt-6 bg-white rounded-3xl border border-ink-100 p-6 sm:p-8">
      <h2 class="font-display font-bold text-lg">Horario de atención</h2>
      <p class="text-sm text-slate-600 mt-1">Lunes a viernes 9–18 hs · Las Flores, Buenos Aires.</p>
    </div>
    <form id="form-contacto" class="mt-6 bg-white rounded-3xl border border-ink-100 p-6 sm:p-8 space-y-5" novalidate>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="contacto-nombre" class="block text-sm font-semibold mb-1.5">Nombre *</label>
          <input id="contacto-nombre" name="name" required minlength="2" maxlength={CONTACT_LIMITS.name} autocomplete="name" class="w-full px-4 py-3 rounded-xl border border-ink-200 outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
        <div>
          <label for="contacto-email" class="block text-sm font-semibold mb-1.5">Email *</label>
          <input id="contacto-email" name="email" type="email" required maxlength={CONTACT_LIMITS.email} autocomplete="email" class="w-full px-4 py-3 rounded-xl border border-ink-200 outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
      </div>
      <div>
        <label for="contacto-asunto" class="block text-sm font-semibold mb-1.5">Asunto *</label>
        <input id="contacto-asunto" name="subject" required minlength="3" maxlength={CONTACT_LIMITS.subject} class="w-full px-4 py-3 rounded-xl border border-ink-200 outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
      <div>
        <label for="contacto-mensaje" class="block text-sm font-semibold mb-1.5">Mensaje *</label>
        <textarea id="contacto-mensaje" name="message" required minlength="10" maxlength={CONTACT_LIMITS.message} rows="5" class="w-full px-4 py-3 rounded-xl border border-ink-200 outline-none focus:ring-2 focus:ring-brand-500"></textarea>
      </div>
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="contacto-website">Website</label>
        <input id="contacto-website" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <p id="contacto-error" role="alert" tabindex="-1" hidden class="text-sm font-semibold text-red-600"></p>
      <p id="contacto-ok" role="status" tabindex="-1" hidden class="text-sm font-semibold text-emerald-700">¡Listo! Ahora se abre WhatsApp: tocá enviar para que nos llegue tu consulta.</p>
      <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-ink-950 text-white font-bold hover:bg-ink-800 active:scale-[0.99] transition">
        <Icon name="send" size={18} /> Pasar a WhatsApp y enviar mi consulta
      </button>
      <p class="text-xs text-slate-500 text-center">Este formulario prepara tu mensaje y lo terminás de enviar en WhatsApp. Simple y sin cuentas.</p>
    </form>
  </section>
</BaseLayout>

<script>
  import { validateContactInput } from '@/utils/contact';

  const form = document.getElementById('form-contacto') as HTMLFormElement | null;
  const error = document.getElementById('contacto-error');
  const success = document.getElementById('contacto-ok');
  const DESTINO = '5492224000000';

    form?.addEventListener('submit', (e: Event) => {
      e.preventDefault();
      if (error) error.hidden = true;
      if (success) success.hidden = true;
      const payload = Object.fromEntries(new FormData(form).entries());
      // Honeypot: los bots la completan, las personas no la ven
      if (typeof payload.website === 'string' && payload.website.trim()) return;
      // Throttle cliente (el sitio es estático): un envío cada 10 s por pestaña
      const ahora = Date.now();
      const ultimo = Number(sessionStorage.getItem('contacto-ultimo') ?? 0);
      if (ahora - ultimo < 10_000) {
        if (error) {
          error.textContent = 'Ya enviaste una consulta hace segundos. Esperá un momento antes de reintentar.';
          error.hidden = false;
          error.focus();
        }
        return;
      }
      const local = validateContactInput(payload);
      if (!local.ok) {
        if (error) {
          error.textContent = Object.values(local.errors)[0] ?? 'Revisá los datos ingresados.';
          error.hidden = false;
          error.focus();
        }
        return;
      }

      // Sitio 100% estático: sin backend, el envío se completa en WhatsApp
      const text = `Hola, soy ${local.data?.name}.\nEmail: ${local.data?.email}\nAsunto: ${local.data?.subject}\n\n${local.data?.message}`;
      sessionStorage.setItem('contacto-ultimo', String(ahora));
      if (success) {
        success.hidden = false;
        success.focus?.();
      }
      window.open(`https://wa.me/${DESTINO}?text=${encodeURIComponent(text)}`, '_blank', 'noopener,noreferrer');
    });
</script>
