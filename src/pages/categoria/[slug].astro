---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BusinessCard from '@/components/BusinessCard.astro';
import SlotPublicitario from '@/components/SlotPublicitario.astro';
import { listCategories, getCategory } from '@/data/categories';
import { listBusinesses } from '@/data/businesses';

export const prerender = true;

export async function getStaticPaths() {
  const categories = await listCategories();
  return categories.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const category = await getCategory(slug ?? '');
if (!category) return Astro.redirect('/404');

const businesses = await listBusinesses();
const results = businesses.filter((b) => b.category === category.slug);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${category.name} en Las Flores`,
  itemListElement: results.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://clasificadoslasflores.com.ar/comercio/${b.slug}`,
    name: b.name,
  })),
};
---

<BaseLayout
  title={`${category.name} en Las Flores`}
  description={`${category.description} Encontrá ${category.name.toLowerCase()} en Las Flores, provincia de Buenos Aires, con contacto directo por WhatsApp.`}
  schema={schema}
>
  <section class={`bg-gradient-to-br ${category.color} text-white`}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
      <nav aria-label="Miga de pan" class="text-sm text-white/70">
        <a href="/" class="hover:text-white">Inicio</a> / <a href="/directorio" class="hover:text-white">Directorio</a> / <span class="text-white font-medium">{category.name}</span>
      </nav>
      <p class="mt-4 text-5xl" aria-hidden="true">{category.icon}</p>
      <h1 class="mt-2 font-display font-extrabold text-3xl sm:text-5xl">{category.name} en Las Flores</h1>
      <p class="mt-3 text-white/85 max-w-2xl">{category.description}</p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    {results.length === 0 ? (
      <div class="text-center py-14 bg-white rounded-3xl border border-ink-100">
        <p class="font-display font-bold text-xl">Todavía no hay publicaciones en {category.name}</p>
        <a href="/publicar" class="mt-4 inline-flex px-5 py-3 rounded-xl bg-brand-600 text-white text-sm font-bold">Sé el primero en publicar gratis</a>
      </div>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {results.map((b) => <BusinessCard business={b} />)}
        <SlotPublicitario titulo={`Sé el primero en ${category.name}`} texto="Mostrá tu negocio acá antes que otros del rubro." />
      </div>
    )}
  </section>
</BaseLayout>
