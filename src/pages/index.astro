---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CategoryGrid from '@/components/CategoryGrid.astro';
import BusinessCard from '@/components/BusinessCard.astro';
import SlotPublicitario from '@/components/SlotPublicitario.astro';
import Socios from '@/components/Socios.astro';
import InformacionUtil from '@/components/InformacionUtil.astro';
import PlanCard from '@/components/PlanCard.astro';
import VidrieraDestacada from '@/components/VidrieraDestacada.astro';
import VentasCard from '@/components/VentasCard.astro';
import CountUp from '@astroanimate/core/CountUp';
import Icon from '@/components/Icon.astro';
import { listBusinesses } from '@/data/businesses';
import { listCategories } from '@/data/categories';
import { listPlans } from '@/data/plans';
import { planesVisibles } from '@/utils/site';
import { organizationSchema, faqPageSchema } from '@/utils/site';

const businesses = await listBusinesses();
const categories = await listCategories();
const plans = planesVisibles(await listPlans());
// Misma distribución que /planes: 3 base en grilla, Vidriera a todo el ancho.
const planesBase = plans.filter((p) => p.tier !== 'oro');
const vidriera = plans.find((p) => p.tier === 'oro');

const destacados = businesses.filter((b) => b.plan === 'oro' || b.featured).slice(0, 3);
const recientes = [...businesses].sort((a, b) => b.createdAt.localeCompare(a.createdAt)).slice(0, 6);

// Prueba social real, calculada en build desde las collections (sin inventar nada)
const pctVerificados = businesses.length
  ? Math.round((businesses.filter((b) => b.verified).length / businesses.length) * 100)
  : 0;

// AEO/GEO: long-tail real del lanzamiento ("plomero en Las Flores",
// "cómo publico mi negocio", desambiguación vs. Flores/CABA).
const faqsHome = [
  { q: '¿Qué es Clasificados Las Flores?', a: 'El directorio y guía comercial de Las Flores, provincia de Buenos Aires: comercios, oficios y servicios locales con contacto directo por WhatsApp.' },
  { q: '¿Cómo busco un plomero o electricista en Las Flores?', a: 'Escribí el rubro en el buscador o entrá a la categoría Servicios del directorio. Cada ficha muestra dirección, horarios y botón de WhatsApp directo.' },
  { q: '¿Cuánto cuesta publicar mi negocio?', a: 'Empezar es gratis para siempre. Contacto Directo cuesta $5.000 por mes, Comercio Verificado $12.000 y Vidriera Digital $20.000.' },
  { q: '¿Cómo publico mi comercio?', a: 'Completá el formulario en Publicar y lo enviás por WhatsApp. Te contactamos en menos de 24 horas para activar tu ficha.' },
  { q: '¿Es de Las Flores, Buenos Aires o del barrio de Flores?', a: 'De la ciudad de Las Flores, provincia de Buenos Aires, Argentina. No del barrio de Flores de la Ciudad de Buenos Aires.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Clasificados Las Flores',
    url: 'https://clasificadoslasflores.com.ar',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://clasificadoslasflores.com.ar/directorio?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  },
  organizationSchema(),
  // AEO: respuestas directas a long-tail ("plomero en Las Flores", "cómo publicar"...).
  // Misma fuente para el HTML visible y el schema.
  faqPageSchema(faqsHome),
];
---

<BaseLayout
  title="Directorio y clasificados en Las Flores, Buenos Aires"
  description="Guía comercial y clasificados de Las Flores, Buenos Aires: plomeros, electricistas, gastronomía, alquileres y empleo. Contacto directo por WhatsApp."
  schema={schema}
>
  <link slot="head" rel="preconnect" href="https://dolarapi.com" />
  {/* HERO */}
  <section class="relative overflow-hidden bg-ink-950 text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_20%,rgba(51,143,250,0.28),transparent_32%),linear-gradient(120deg,#020617_0%,#0b2355_54%,#155ddc_140%)]" aria-hidden="true" />
    <div class="absolute inset-0 aurora-layer" aria-hidden="true" />
    <div class="absolute inset-0 dot-grid dot-grid-animated opacity-70" aria-hidden="true" />
    <div class="absolute -left-1/3 top-1/4 h-[28rem] w-[28rem] beam-conic" aria-hidden="true" />
    <div class="absolute bottom-0 left-1/4 h-40 w-[42rem] hero-horizon" aria-hidden="true" />
    <div class="absolute -right-40 top-20 h-[34rem] w-[34rem] rounded-full border border-white/10 rotate-12" aria-hidden="true" />
    <div class="absolute -right-24 top-44 h-[26rem] w-[26rem] rounded-full border border-amber-300/20 -rotate-12" aria-hidden="true" />

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-12 sm:py-20 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(25rem,0.82fr)] lg:gap-16" data-reveal-group>
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-emerald-300/25 bg-emerald-300/10 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-emerald-200">
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-300 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-300"></span>
            </span>
            Las Flores está activa
          </p>
          <h1 class="mt-5 max-w-3xl font-display text-4xl font-extrabold leading-[1.02] tracking-tight text-balance sm:text-6xl lg:text-[4.5rem]">
            Lo que necesitás,
            <span class="mt-1 block text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-yellow-100 to-orange-400 shine-text">más cerca.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300 sm:text-xl">
            Comercios, oficios y servicios de Las Flores, provincia de Buenos Aires. Encontrá a quién llamar, compará opciones y resolvé más rápido.
          </p>

          {/* Buscador (progresivo: funciona sin JS vía GET) */}
          <form action="/directorio" method="get" role="search" data-event="buscar" class="mt-8 max-w-2xl rounded-2xl border border-white/20 bg-white p-2 shadow-[0_24px_80px_rgba(2,6,23,0.45)] sm:flex sm:items-center">
            <label class="sr-only" for="q">Buscar comercios o servicios</label>
            <div class="flex min-w-0 flex-1 items-center gap-3 px-3">
              <Icon name="search" size={19} class="shrink-0 text-brand-600" />
              <input id="q" name="q" type="search" inputmode="search" enterkeyhint="search" placeholder="Buscá un rubro, comercio o servicio…" autocomplete="off" class="min-w-0 flex-1 py-3 text-ink-900 outline-none placeholder:text-slate-400" />
            </div>
            <button type="submit" class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 font-bold text-white transition hover:bg-brand-700 active:scale-[0.98] sm:mt-0 sm:w-auto">
              Buscar en Las Flores <Icon name="arrow-right" size={17} />
            </button>
          </form>

          <div class="mt-5 flex flex-wrap items-center gap-2 text-sm">
            <span class="mr-1 text-slate-400">Probá con:</span>
            {['Plomero', 'Pizza', 'Alquiler', 'Café'].map((t) => (
              <a href={`/directorio?q=${encodeURIComponent(t)}`} class="rounded-full border border-white/15 bg-white/10 px-3.5 py-2 font-medium text-slate-100 transition hover:border-white/30 hover:bg-white/20">{t}</a>
            ))}
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-[31rem] lg:mx-0">
          <div class="absolute -inset-5 rounded-[2.5rem] bg-brand-400/15 blur-3xl" aria-hidden="true" />
          <div class="relative overflow-hidden rounded-[2rem] border border-white/20 bg-white/[0.08] p-3 shadow-2xl backdrop-blur-xl float-soft">
            <div class="relative min-h-[25rem] overflow-hidden rounded-[1.5rem] bg-[#dcecff] p-4 text-ink-900 sm:min-h-[29rem]">
              <div class="absolute inset-0 opacity-60" aria-hidden="true">
                <div class="absolute left-[12%] top-[18%] h-px w-[84%] rotate-[18deg] bg-brand-600/25" />
                <div class="absolute left-[-5%] top-[52%] h-px w-[115%] -rotate-[26deg] bg-brand-600/20" />
                <div class="absolute left-[43%] top-[-5%] h-[115%] w-px rotate-[24deg] bg-brand-600/20" />
                <div class="absolute left-[70%] top-[-10%] h-[120%] w-px -rotate-[35deg] bg-brand-600/15" />
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_30%,rgba(255,255,255,0.9)_0_3px,transparent_4px),radial-gradient(circle_at_75%_65%,rgba(21,93,220,0.22)_0_2px,transparent_3px)] bg-[length:42px_42px,31px_31px]" />
              </div>
              <div class="relative flex items-center justify-between">
                <span class="rounded-full bg-white/80 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.15em] text-brand-700 shadow-sm">Mapa local</span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-ink-950 px-3 py-1.5 text-[11px] font-bold text-white"><span class="h-1.5 w-1.5 rounded-full bg-emerald-400" /> Las Flores</span>
              </div>
              <div class="absolute left-[19%] top-[31%] grid h-9 w-9 place-items-center rounded-full border-4 border-white bg-brand-600 text-white shadow-lg shadow-brand-900/30 float-soft" aria-hidden="true"><Icon name="pin" size={16} /></div>
              <div class="absolute right-[18%] top-[22%] grid h-8 w-8 place-items-center rounded-full border-4 border-white bg-amber-400 text-sm font-bold text-ink-950 shadow-lg float-soft-delayed" aria-label="★ Negocio destacado">★</div>
              <div class="absolute right-[25%] bottom-[28%] grid h-9 w-9 place-items-center rounded-full border-4 border-white bg-emerald-500 text-white shadow-lg float-soft" aria-hidden="true"><Icon name="whatsapp" size={15} /></div>
              <div class="absolute bottom-4 left-4 right-4 rounded-2xl border border-white/80 bg-white/90 p-4 shadow-xl backdrop-blur">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-brand-600">Recomendado cerca de vos</p>
                    <h2 class="mt-1 font-display text-lg font-bold leading-tight">{destacados[0]?.name ?? 'Tu próximo contacto'}</h2>
                    <p class="mt-1 text-xs text-slate-500">{destacados[0]?.shortDescription ?? 'Negocios y servicios de Las Flores'}</p>
                  </div>
                  <span class="rounded-lg bg-amber-100 px-2 py-1 text-xs font-bold text-amber-700">★ Destacado</span>
                </div>
                <div class="mt-3 flex items-center justify-between border-t border-ink-100 pt-3 text-xs font-semibold text-slate-600">
                  <span>Las Flores · Buenos Aires</span>
                  <span class="text-emerald-600">Contacto directo</span>
                </div>
              </div>
            </div>
          </div>
          <div class="absolute -bottom-5 -left-5 hidden rounded-2xl border border-white/20 bg-ink-950/90 px-4 py-3 text-white shadow-xl backdrop-blur sm:block">
            <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-amber-300">Empezamos juntos</p>
            <p class="mt-1 font-display text-sm font-bold">
              {businesses.length} {businesses.length === 1 ? 'negocio publicado' : 'negocios publicados'}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* PRUEBA SOCIAL — la única banda de números, 100% datos reales */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-12" aria-label="Confianza de la comunidad">
    <dl class="grid grid-cols-3 gap-3 sm:gap-4 max-w-3xl mx-auto text-center">
      <div class="bg-white rounded-2xl border border-ink-100 px-3 py-4 shadow-sm">
        <dd class="font-display font-extrabold text-2xl text-ink-900 tabular-nums"><CountUp value={businesses.length} duration={1200} enhance fontSize="inherit" textColor="inherit" fontFamily="inherit" /></dd>
        <dt class="text-xs text-slate-500 mt-1">{businesses.length === 1 ? 'negocio publicado' : 'negocios publicados'}</dt>
      </div>
      <div class="bg-white rounded-2xl border border-ink-100 px-3 py-4 shadow-sm">
        <dd class="font-display font-extrabold text-2xl text-ink-900 tabular-nums"><CountUp value={categories.length} duration={1400} enhance fontSize="inherit" textColor="inherit" fontFamily="inherit" /></dd>
        <dt class="text-xs text-slate-500 mt-1">categorías</dt>
      </div>
      <div class="bg-white rounded-2xl border border-ink-100 px-3 py-4 shadow-sm">
        {pctVerificados > 0 ? (
          <>
            <dd class="font-display font-extrabold text-2xl text-ink-900">{pctVerificados}%</dd>
            <dt class="text-xs text-slate-500 mt-1">perfiles verificados</dt>
          </>
        ) : (
          <>
            <dd class="font-display font-extrabold text-2xl text-ink-900">Desde $0</dd>
            <dt class="text-xs text-slate-500 mt-1">empezar es gratis</dt>
          </>
        )}
      </div>
    </dl>
  </section>

  {/* CATEGORÍAS */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-14">
    <SectionHeading
      eyebrow="Explorá"
      title="Buscá por categoría"
      description="Gastronomía, oficios, inmuebles, vehículos, empleo y más — en un solo lugar."
    />
    <div class="mt-8" data-reveal><CategoryGrid /></div>
  </section>

  {/* INFORMACIÓN ÚTIL */}
  <InformacionUtil businesses={businesses} />

  {/* DESTACADOS ORO */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-16">
    <div class="flex items-end justify-between gap-4 mb-7">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-amber-700 mb-2">★ Vidriera Digital</p>
        <h2 class="font-display font-bold text-3xl tracking-tight">Comercios destacados</h2>
      </div>
      <a href="/directorio" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:underline slide-arrow">Ver directorio <Icon name="arrow-right" size={15} /></a>
    </div>
    <div class="grid items-stretch grid-cols-1 sm:grid-cols-3 gap-5">
      {destacados.map((b) => <BusinessCard business={b} />)}
      <SlotPublicitario variante="oro" plan="oro" titulo="Tu marca acá" texto="Aparecé en el inicio con borde dorado y difusión en nuestras redes." />
      <SlotPublicitario variante="oro" plan="oro" titulo="Tu logo acá" texto="Vidriera Digital: destacá en el inicio por $20.000 por mes." />
      <SlotPublicitario variante="oro" plan="oro" titulo="Tu rubro acá" texto="Visible en el inicio toda la semana." />
    </div>
  </section>

  {/* BANNER PUBLICITE AQUÍ — la única sección dorada del home, imposible de confundir
      con contenido. Va justo después de Destacados a propósito: el comerciante
      acaba de ver a su competencia destacada y piensa "yo quiero eso". Copy
      directo al anunciante, formatos concretos, CTA a ventas. */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-16" aria-label="Publicite aquí">
    <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-amber-300 via-amber-400 to-yellow-500 text-ink-950 p-8 sm:p-12 shadow-[0_24px_60px_-20px_rgba(217,119,6,0.5)]" data-reveal>
      <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-white/25 blur-3xl" aria-hidden="true" />
      <div class="absolute -bottom-32 -left-16 w-96 h-96 rounded-full bg-orange-600/20 blur-3xl" aria-hidden="true" />
      <div class="relative grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:gap-12 items-center">
        <div>
          <p class="inline-flex px-4 py-1.5 rounded-full text-[11px] font-extrabold uppercase tracking-[0.2em] bg-ink-950 text-amber-300">Publicite aquí</p>
          <h2 class="mt-4 font-display font-extrabold text-3xl sm:text-4xl tracking-tight text-balance">Tu marca donde todo el barrio mira</h2>
          <p class="mt-3 font-medium text-ink-900/80 max-w-lg">Banner en el inicio, destacado en tu categoría y difusión en nuestras redes. Para eventos, instituciones y marcas de la zona.</p>
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href="/contacto" data-event="cta_publicidad" data-props={JSON.stringify({ origen: 'banner-home' })} class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-ink-950 text-white font-bold hover:bg-ink-800 active:scale-[0.98] transition btn-sheen slide-arrow">Quiero publicitar <Icon name="arrow-right" size={16} /></a>
            <a href="/planes" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl border-2 border-ink-950/25 font-bold hover:border-ink-950 hover:bg-white/20 transition">Ver planes de fichas</a>
          </div>
          <p class="mt-3 text-xs font-semibold text-ink-900/70">Espacios limitados · Sin permanencia · Precio sin compromiso</p>
        </div>
        <ul class="grid gap-3">
          <li class="flex items-center gap-3 rounded-2xl bg-ink-950/90 text-white p-4">
            <span class="w-10 h-10 shrink-0 rounded-xl bg-amber-400 grid place-items-center text-ink-950" aria-hidden="true"><Icon name="megafono" size={19} /></span>
            <div><p class="font-bold text-sm">Banner en el inicio</p><p class="text-xs text-slate-300">El primer impacto de cada visita</p></div>
          </li>
          <li class="flex items-center gap-3 rounded-2xl bg-ink-950/90 text-white p-4">
            <span class="w-10 h-10 shrink-0 rounded-xl bg-amber-400 grid place-items-center text-ink-950" aria-hidden="true"><Icon name="pin" size={19} /></span>
            <div><p class="font-bold text-sm">Destacado en tu categoría</p><p class="text-xs text-slate-300">Primero cuando buscan tu rubro</p></div>
          </li>
          <li class="flex items-center gap-3 rounded-2xl bg-ink-950/90 text-white p-4">
            <span class="w-10 h-10 shrink-0 rounded-xl bg-amber-400 grid place-items-center text-ink-950" aria-hidden="true"><Icon name="share" size={19} /></span>
            <div><p class="font-bold text-sm">Difusión en redes</p><p class="text-xs text-slate-300">Lo compartimos en Instagram y Facebook</p></div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {/* RECIENTES */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-16">
    <SectionHeading eyebrow="Novedades" title="Recién llegados" description="Los negocios más nuevos de Las Flores." />
    <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-reveal-group>
      {recientes.map((b) => <BusinessCard business={b} />)}
      <SlotPublicitario titulo="Tu negocio acá" texto="Publicá gratis y aparecé junto a los destacados." />
      <SlotPublicitario titulo="Tu negocio acá" texto="Sin tarjeta, en pocos pasos, directo a tu WhatsApp." />
    </div>
    <div class="text-center mt-8">
      <a href="/directorio" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:underline slide-arrow">Ver todo el directorio <Icon name="arrow-right" size={15} /></a>
    </div>
  </section>

  {/* CÓMO FUNCIONA — timeline editorial con mocks visuales */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-16" aria-labelledby="como-funciona">
    <div class="relative overflow-hidden rounded-[2rem] bg-ink-950 text-white p-8 sm:p-12">
      <div class="absolute inset-0 dot-grid" aria-hidden="true" />
      <div class="absolute -top-28 left-1/3 w-96 h-96 rounded-full bg-brand-600/25 blur-3xl float-soft" aria-hidden="true" />
      <div class="relative" data-reveal>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-amber-300">Cómo funciona</p>
        <h2 id="como-funciona" class="mt-2 font-display font-extrabold text-3xl sm:text-4xl tracking-tight text-balance">De la búsqueda al WhatsApp en 3 pasos</h2>
        <p class="mt-3 text-slate-300 max-w-xl">Sin cuentas ni vueltas: así se usa el directorio, tanto para vecinos como para negocios.</p>
      </div>

      <ol class="relative mt-10 grid md:grid-cols-3 gap-10 md:gap-8" data-reveal-group>
        <span class="steps-line absolute top-[4.75rem] left-[16%] right-[16%] h-px bg-gradient-to-r from-transparent via-white/30 to-transparent hidden md:block" aria-hidden="true"></span>

        <li class="group relative rounded-2xl p-5 -m-5 hover:bg-white/5 transition-colors">
          <span class="absolute top-0 right-2 font-display font-extrabold text-7xl text-white/[0.07] select-none" aria-hidden="true">01</span>
          <div class="flex items-center gap-3">
            <span class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-500 to-indigo-500 grid place-items-center shadow-lg shadow-brand-900/40 group-hover:scale-105 transition-transform" aria-hidden="true"><Icon name="search" size={24} class="text-white" /></span>
            <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Paso 1</span>
          </div>
          <h3 class="mt-4 font-display font-bold text-xl">Buscá</h3>
          <p class="mt-1.5 text-sm text-slate-400 leading-relaxed">Filtrá por categoría o escribí lo que necesitás. Los destacados pagos van primero.</p>
          <div class="mt-5 rounded-xl bg-white/10 border border-white/10 p-2 flex items-center gap-2" aria-hidden="true">
            <span class="flex-1 text-xs text-slate-400 px-2">plomero urgente…</span>
            <span class="w-9 h-9 rounded-lg bg-brand-500 grid place-items-center"><Icon name="search" size={15} class="text-white" /></span>
          </div>
        </li>

        <li class="group relative rounded-2xl p-5 -m-5 hover:bg-white/5 transition-colors">
          <span class="absolute top-0 right-2 font-display font-extrabold text-7xl text-white/[0.07] select-none" aria-hidden="true">02</span>
          <div class="flex items-center gap-3">
            <span class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-600 grid place-items-center shadow-lg shadow-emerald-900/40 group-hover:scale-105 transition-transform" aria-hidden="true"><Icon name="check" size={24} class="text-white" /></span>
            <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Paso 2</span>
          </div>
          <h3 class="mt-4 font-display font-bold text-xl">Verificá</h3>
          <p class="mt-1.5 text-sm text-slate-400 leading-relaxed">Priorizamos perfiles con identidad confirmada para que no caigas en estafas.</p>
          <div class="mt-5 rounded-xl bg-white/10 border border-white/10 p-3 flex items-center gap-2.5" aria-hidden="true">
            <span class="w-9 h-9 rounded-full bg-gradient-to-br from-amber-300 to-orange-500 shrink-0"></span>
            <span class="flex-1"><span class="block h-2 rounded-full bg-white/30 w-2/3"></span><span class="block h-2 rounded-full bg-white/15 w-1/3 mt-1.5"></span></span>
            <span class="text-[10px] font-bold bg-white text-ink-950 px-2.5 py-1 rounded-full">✓ Verificado</span>
          </div>
        </li>

        <li class="group relative rounded-2xl p-5 -m-5 hover:bg-white/5 transition-colors">
          <span class="absolute top-0 right-2 font-display font-extrabold text-7xl text-white/[0.07] select-none" aria-hidden="true">03</span>
          <div class="flex items-center gap-3">
            <span class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#25D366] to-emerald-700 grid place-items-center shadow-lg shadow-emerald-900/40 group-hover:scale-105 transition-transform" aria-hidden="true"><Icon name="whatsapp" size={24} class="text-white" /></span>
            <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Paso 3</span>
          </div>
          <h3 class="mt-4 font-display font-bold text-xl">Contactá</h3>
          <p class="mt-1.5 text-sm text-slate-400 leading-relaxed">Tocás un botón con el mensaje ya redactado y hablás directo con el comercio, sin intermediarios.</p>
          <div class="mt-5 space-y-2" aria-hidden="true">
            <p class="bg-white text-ink-900 text-xs rounded-2xl rounded-bl-md px-3 py-2.5 w-fit max-w-full">Hola, vi tu publicación en Clasificados…</p>
            <p class="rounded-xl bg-[#25D366] text-white text-sm font-bold px-4 py-2.5 flex items-center gap-2 w-fit"><Icon name="whatsapp" size={16} class="text-white" /> Enviar</p>
          </div>
        </li>
      </ol>

      <div class="relative mt-10 flex flex-col sm:flex-row gap-3" data-reveal>
        <a href="/directorio" data-event="cta_directorio" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-white text-ink-900 font-bold hover:bg-brand-50 active:scale-[0.98] transition btn-sheen slide-arrow">Buscar lo que necesito <Icon name="arrow-right" size={17} /></a>
        <a href="/publicar" data-event="cta_publicar" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl border border-white/30 font-bold hover:bg-white/10 active:scale-[0.98] transition">Publicar mi negocio</a>
      </div>
    </div>
  </section>

  {/* HISTORIA — va DESPUÉS de "cómo funciona" a propósito: primero el visitante
      entiende qué resuelve el directorio, después le pedimos que confíe en
      quiénes somos. Antes estaba en el puesto 3 y competía con el hero. */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-16" aria-label="Por qué existe">
    <div class="relative overflow-hidden rounded-[2rem] border border-brand-100 bg-gradient-to-b from-brand-50/70 to-white p-8 sm:p-12">
      <div class="max-w-3xl mx-auto text-center" data-reveal>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600 mb-3">Por qué existe</p>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl tracking-tight text-balance">
          Un grupo de WhatsApp no puede ordenar una ciudad
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed text-pretty">
          El problema de Las Flores nunca fue la falta de comercios: es encontrarlos.
          Necesitás un plomero un martes a la tarde y lo que tenés es un grupo con mil
          mensajes, un flyer del año pasado y tres números que no atienden. Nosotros no
          inventamos nada nuevo: ordenamos lo que ya existía.
        </p>
      </div>

      <ol class="mt-10 grid md:grid-cols-3 gap-4 max-w-5xl mx-auto" data-reveal-group>
        <li class="bg-white rounded-2xl border border-ink-100 p-6 shadow-sm">
          <p class="font-display font-extrabold text-3xl text-brand-200" aria-hidden="true">01</p>
          <h3 class="mt-2 font-display font-bold text-lg">El enredo</h3>
          <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">
            La info comercial vivía en chats, stories y contactos guardados:
            lenta de encontrar, imposible de verificar y con dos años de atraso.
          </p>
        </li>
        <li class="bg-white rounded-2xl border border-ink-100 p-6 shadow-sm">
          <p class="font-display font-extrabold text-3xl text-brand-200" aria-hidden="true">02</p>
          <h3 class="mt-2 font-display font-bold text-lg">La idea</h3>
          <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">
            Un solo lugar ordenado por rubro, con contacto directo a WhatsApp
            y fichas verificadas. Simple como tiene que ser.
          </p>
        </li>
        <li class="bg-white rounded-2xl border-2 border-brand-300 p-6 shadow-md">
          <p class="font-display font-extrabold text-3xl text-brand-600" aria-hidden="true">03</p>
          <h3 class="mt-2 font-display font-bold text-lg">Tu parte</h3>
          <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">
            El directorio solo sirve si el barrio lo completa. Cada comercio que
            se suma lo vuelve más útil para todos los demás.
          </p>
        </li>
      </ol>

      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3" data-reveal>
        <a href="/publicar" data-event="cta_historia" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-brand-600 text-white font-bold hover:bg-brand-700 active:scale-[0.98] transition btn-sheen">Sumar mi comercio <Icon name="arrow-right" size={16} /></a>
        <a href="/nosotros" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl border-2 border-ink-200 font-bold hover:border-ink-900 transition">Quiénes somos</a>
      </div>
    </div>
  </section>

  {/* PLANES */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-16" id="planes">
    <SectionHeading eyebrow="Para negocios" title="Planes para que te encuentren más fácil" description="Empezá gratis y escalá cuando necesites más clientes. Sin permanencia." />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto" data-reveal-group>
      {planesBase.map((p) => <PlanCard plan={p} />)}
    </div>
    {vidriera && <VidrieraDestacada plan={vidriera} />}
    <div class="mt-6 max-w-2xl mx-auto">
      <VentasCard />
    </div>
  </section>

  {/* SOCIOS */}
  <Socios />

  {/* FAQ AEO — mismas respuestas del schema FAQPage, en HTML visible */}
  <section class="max-w-3xl mx-auto px-4 sm:px-6 pt-16" aria-label="Preguntas frecuentes">
    <h2 class="font-display font-bold text-2xl sm:text-3xl tracking-tight text-center text-balance">Preguntas de vecinos y comercios</h2>
    <div class="mt-6 rounded-3xl border border-ink-100 bg-white p-6 sm:p-8" data-reveal>
      {faqsHome.map((f) => (
        <details class="py-3 border-b border-ink-100 last:border-0" name="faq-home">
          <summary class="font-semibold cursor-pointer">{f.q}</summary>
          <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  {/* CTA FINAL */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="rounded-3xl bg-gradient-to-br from-brand-600 to-indigo-700 text-white p-10 sm:p-14 text-center">
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-balance">¿Tenés un negocio en Las Flores?</h2>
      <p class="mt-3 text-brand-100 max-w-xl mx-auto">Publicá gratis en pocos minutos y empezá a recibir consultas directas a tu WhatsApp.</p>
      <div class="mt-6 flex flex-col sm:flex-row justify-center gap-3">
        <a href="/publicar" data-event="cta_publicar" class="px-7 py-3.5 rounded-xl bg-white text-brand-700 font-bold hover:bg-brand-50 active:scale-[0.98] transition">Publicar mi negocio gratis</a>
        <a href="/planes" class="px-7 py-3.5 rounded-xl border border-white/40 font-bold hover:bg-white/10">Ver planes</a>
      </div>
      <p class="mt-4 text-sm text-brand-100">✓ Gratis · ✓ Sin tarjeta · ✓ En pocos pasos</p>
    </div>
  </section>
</BaseLayout>
