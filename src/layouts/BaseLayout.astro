---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Asistente from '@/components/Asistente.astro';
import type { SeoProps } from '@/utils/site';
import { SITE, ogImageMeta } from '@/utils/site';
// Preload de los únicos subsets que usa el copy en español (verificado: 0
// caracteres latin-ext en src/). Acelera el LCP tipográfico sin peso extra.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import soraLatin from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';

interface Props extends SeoProps {}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  schema,
} = Astro.props as Props;

const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const canonicalUrl = canonical ?? `${SITE.url}${Astro.url.pathname}`;
// Open Graph: resuelve la imagen a un formato que las redes sepan renderizar
// (nunca SVG) y con sus dimensiones reales, no 1200x630 inventadas.
const og = ogImageMeta(image);
const imageUrl = og.src.startsWith('http') ? og.src : `${SITE.url}${og.src}`;
const ogAlt = imageAlt ?? fullTitle;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {og.width && <meta property="og:image:width" content={String(og.width)} />}
    {og.height && <meta property="og:image:height" content={String(og.height)} />}
    <meta property="og:image:type" content={`image/${og.ext}`} />
    <meta property="og:image:alt" content={ogAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1c72ef" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin />
    <meta name="robots" content="index, follow" />
    {/* SEO local clásico: georreferenciación de la página */}
    <meta name="geo.region" content="AR-B" />
    <meta name="geo.placename" content="Las Flores, Buenos Aires, Argentina" />
    <meta name="geo.position" content="-36.0172;-59.1" />
    <meta name="ICBM" content="-36.0172, -59.1" />
    <link rel="icon" type="image/png" href="/favicon-flores.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-flores.png" />

    {/* Fuentes self-hosted vía fontsource (ver src/styles/global.css). Sin terceros bloqueantes. */}
    {/* Sin JS: los reveals nunca deben ocultar contenido */}
    <noscript>
      <style>
        [data-reveal], [data-reveal-group] > * { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
    <script is:inline>document.documentElement.classList.add('js');</script>

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
    <slot name="head" />
  </head>
  <body class="bg-ink-50 text-ink-900 antialiased min-h-dvh flex flex-col">
    <a href="#contenido" class="skip-link bg-brand-600 text-white px-4 py-2 rounded-lg font-semibold">
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Asistente />

    {/* Botón Volver arriba: aparece tras scroll y evita que el usuario quede atrapado en el footer */}
    <button
      id="volver-arriba"
      type="button"
      aria-label="Volver al inicio de la página"
      class="fixed left-4 bottom-20 z-[55] w-12 h-12 rounded-full bg-brand-600 text-white flex items-center justify-center shadow-xl opacity-0 translate-y-10 pointer-events-none transition-all duration-300 ease-out hover:bg-brand-700 active:scale-95 focus:outline-none focus:ring-2 focus:ring-brand-600 focus:ring-offset-2">
      <span class="text-[18px]" aria-hidden="true">↑</span>
      <span class="sr-only">Volver arriba</span>
    </button>
    <script>
      // Reveal on scroll: IntersectionObserver nativo + transiciones CSS.
      // A prueba de balas: si no hay IO, todo visible. Sin JS, el CSS nunca oculta.
      const targets = document.querySelectorAll('[data-reveal], [data-reveal-group]');
      if (!('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.classList.add('in');
              if (el.hasAttribute('data-reveal-group')) {
                Array.from(el.children).forEach((child, i) => {
                  (child as HTMLElement).style.transitionDelay = `${Math.min(i, 8) * 70}ms`;
                });
              }
              io.unobserve(el);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
      }

      const header = document.getElementById('site-header');
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
      onScroll();
      document.addEventListener('scroll', onScroll, { passive: true });
    </script>
    <script>
      // Dispatcher global de eventos de conversión (ver src/utils/analytics.ts).
      // Los CTAs declaran data-event="nombre" y data-props='{"k":"v"}'.
      import { track } from '@/utils/analytics';
      document.addEventListener('click', (e: Event) => {
        const el = (e.target as HTMLElement).closest?.('[data-event]') as HTMLElement | null;
        if (!el) return;
        let props: Record<string, string> = {};
        try {
          props = JSON.parse(el.dataset.props ?? '{}');
        } catch {
          props = {};
        }
        track(el.dataset.event ?? 'click', props);
      });
      document.addEventListener('submit', (e: Event) => {
        const form = e.target as HTMLFormElement;
        if (form?.dataset?.event) track(form.dataset.event, { form: form.id || 'sin-id' });
      });
    </script>
    <script>
      // Botón Volver arriba: se muestra tras 300px de scroll y vuelve al inicio con scroll suave.
      const btn = document.getElementById('volver-arriba');
      if (btn) {
        const toggle = () => {
          if (window.scrollY > 300) {
            btn.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
            btn.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
          } else {
            btn.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
            btn.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
          }
        };
        toggle();
        document.addEventListener('scroll', toggle, { passive: true });
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
          btn.focus();
        });
      }
    </script>
  </body>
</html>
